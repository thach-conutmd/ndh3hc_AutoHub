    /begin SOURCE
      /* daq name        */ "1ms time synchronous"
      /* period unit CSE */ 3
      /* repetition rate */ 1
      /begin QP_BLOB
        /* RASTER_ID                             */ 1
        /* raster priority [1..32]               */ 4
        /* worst case raster time [us]           */ 900
        /begin ETK_XETK_SPECIFIC
          /* hardware trigger                      */ TRG_NBR 0
        /begin ECU_PROPERTY
            PERFORMANCE  1 1515151 6060604
