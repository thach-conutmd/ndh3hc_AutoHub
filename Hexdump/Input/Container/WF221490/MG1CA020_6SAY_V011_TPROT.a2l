    /begin RASTER_CHECK
        OFFLINE_DEVICE 1 /* device with id 1 is the default device for offline raster check */
        ONLINE_RESPECT_OFFLINE_LIMIT
    /end RASTER_CHECK

      /end ETK_XETK_LIST

    /begin TP_BLOB
       /* ByteOrder */ BYTE_ORDER_MSB_LAST

       /begin DISTAB_CFG
         /* Distab Type */ 17
       /end DISTAB_CFG

    /begin ECU_EVENT_LIST
      0xB92F6720 /* start address of ECU event list        */
     ETK_XETK_REF 1 2 3 4 5 7 8
    /end ECU_EVENT_LIST
    TABLE_ALIGNMENT ALIGNMENT_4_BYTE
    /begin EVENT_CONFIG_OUTPUT_AREA
      0xB92FB5F0 /* start of event config area */
      12324 /* size in bytes of event config area */
      0xB92FE614 /* start of event output area */
      6144 /* size in bytes of event output area */
      ETK_XETK_REF 1 2 3 4 5 7 8
    /end EVENT_CONFIG_OUTPUT_AREA
    /begin DATA_ACQUISITION
      PRIORITY_RANGE 1 4
      ETK_XETK_REF 1 2 3 4 5 7 8
    /end DATA_ACQUISITION
    /begin ECU_PROPERTY
      OVERALL_PERFORMANCE 303030 1212120
      CORE_PERFORMANCE 3 303030 1212120
      CORE_PERFORMANCE 1 454545 1818180
      CORE_PERFORMANCE 2 454545 1818180
      ETK_XETK_REF 1 2 3 4 5 7 8
    /end ECU_PROPERTY
    /begin TRIGGER_CFG
      TRIGGER 29  DIRECT ECU_ID 29
      TRIGGER 30  DIRECT ECU_ID 30
      TRIGGER 31  DIRECT ECU_ID 31
      TRIGGER 32  DIRECT ECU_ID 32
      ETK_XETK_REF 1 2 3 4 5
    /end TRIGGER_CFG
    /begin TRIGGER_CFG
      TRIGGER 93  DIRECT ECU_ID 93
      TRIGGER 94  DIRECT ECU_ID 94
      TRIGGER 95  DIRECT ECU_ID 95
      TRIGGER 96  DIRECT ECU_ID 96
      ETK_XETK_REF 7 8
    /end TRIGGER_CFG
    /begin CODE_CHK
      /* Address ECU DATA section   */ 0x804D8118
      /* Address ECU RAM section    */ 0xB92FFFC4
      /* Length  ECU DATA sections  */ 8
      PATTERN_REFRESH_TIMEOUT 0x200
      ERROR_BEHAVIOR PERMANENT_RESET
      ETK_XETK_REF 1 2 3 4 5 7 8
    /end CODE_CHK
    /begin COLDSTART_HANDSHAKE
      /* Address of ETKS coldstart pattern */    0xB92FFFDC

      WAIT
        /* Dyn. length for wait pattern    */    0xE5 0xAD 0xEC 0x4D

      READY
        /* Dyn. length for ready pattern    */   0xDE 0xC0 0xED 0xFE

    ETK_XETK_REF 1 2 3 4 5 7 8
    /end COLDSTART_HANDSHAKE

    /begin PAGE_SWITCH_METHOD
        2               /* version                              */
        MAILBOX
            3           /* MBX_Version                                 */
                        /* Version of mailbox                          */
            200          /* MBX_PageSetupTime                           */
                        /* max time the ECU needs to set up page in ms */
            0xB92FFFF4  /* MBX_StartAddress                            */
                        /* Start address of table                      */

        AUTOSTART_BEHAVIOR    LAST_ACTIVE_PAGE  /* Table to be filled by INCA with info */
                                                /* for the current active page          */

        OMD
            0xB92FFE18     /* OMD_ADDRESS */
            2  /* OMD_CID */
            0  /* OMD_VERSION */
            0x1A8   /* OMD_MAX_LEN */
            23  /* OMD_NUMBER_OF_EMU_HANDLES */
        CODE_CHK_PATTERN_WP
            0xB92FFFCC /* Start address of WP CodeCheck Pattern  */
        ETK_XETK_REF 1 2 3 4 5 7 8
    /end PAGE_SWITCH_METHOD

    /begin ECU_DEFINED_ERRORCODES
          ERROR_ENTRY 0x00000001 "OMD error"
          ERROR_ENTRY 0x45525201 "ECU will be reset - STOP engine!"
          ERROR_ENTRY 0x45525202 "ECU does not support Programming at T15 OFF"
          ERROR_ENTRY 0x45525203 "Mail Box Version is invalid"
          ERROR_ENTRY 0x45525204 "Call Back Function is not configured"
    /end ECU_DEFINED_ERRORCODES

    /begin DATA_FREEZE
      CONFIG  "SAFETY_MAILBOX_ADDRESS" "0xB92FFFE8" 
      CONFIG  "SAFETY_MAILBOX_VERSION" "0x4D310100" 
      CONFIG  "SAFETY_MAILBOX_WAITMSG" "Datafreeze is pending" 
      CONFIG  "SAFETY_MAILBOX_WAITTOUT" "2000" 
      CONFIG  "STARTUP_MAILBOX_ADDRESS" "0x7003BE00" 
      CONFIG  "STARTUP_MAILBOX_VERSION" "0x4D320100" 
      CONFIG  "VALIDATE_PATTERN" "0x804D8000 0x100" 
      CONFIG  "INVALIDATE_PATTERN" "0x804D8120 0x00044408000004009011000208408C0090508808031010614000280812047640" 
       ETK_XETK_REF 1 2 3 4 5 7 8
    /end DATA_FREEZE

    /end TP_BLOB
    
    /begin SOURCE
      /* daq name        */ "segment synchronous"
      /* period unit CSE */ 103
      /* repetition rate */ 1
      /begin QP_BLOB
        /* RASTER_ID                             */ 2
        /* raster priority [1..32]               */ 3
        /* worst case raster time [us]           */ 2000
        /begin ETK_XETK_SPECIFIC
          /* hardware trigger                      */ TRG_NBR 0
        /begin ECU_PROPERTY
            PERFORMANCE  2 757575 3030300
        /end ECU_PROPERTY
            ETK_XETK_REF 1 2 3 4 5 7 8
        /end ETK_XETK_SPECIFIC
      /end QP_BLOB
    /end SOURCE
    
    /begin SOURCE
      /* daq name        */ "10ms time synchronous"
      /* period unit CSE */ 4
      /* repetition rate */ 1
      /begin QP_BLOB
        /* RASTER_ID                             */ 3
        /* raster priority [1..32]               */ 2
        /* worst case raster time [us]           */ 9000
        /begin ETK_XETK_SPECIFIC
          /* hardware trigger                      */ TRG_NBR 0
        /begin ECU_PROPERTY
            PERFORMANCE  1 151515 606060
        /end ECU_PROPERTY
            ETK_XETK_REF 1 2 3 4 5 7 8
        /end ETK_XETK_SPECIFIC
      /end QP_BLOB
    /end SOURCE
    
    /begin SOURCE
      /* daq name        */ "100ms time synchronous"
      /* period unit CSE */ 5
      /* repetition rate */ 1
      /begin QP_BLOB
        /* RASTER_ID                             */ 4
        /* raster priority [1..32]               */ 1
        /* worst case raster time [us]           */ 90000
        /begin ETK_XETK_SPECIFIC
          /* hardware trigger                      */ TRG_NBR 0
        /begin ECU_PROPERTY
            PERFORMANCE  1 15151 60604
        /end ECU_PROPERTY
            ETK_XETK_REF 1 2 3 4 5 7 8
        /end ETK_XETK_SPECIFIC
