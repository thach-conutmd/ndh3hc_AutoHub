  showDefault(data) {
    data.Instances.forEach(instance => {
      let children = [];
      instance.Members.forEach(member => {
        if (member.__type == 'Person:#MMCBODotNet48.WSData.Common') {
          children.push({
            "Id": member.Id,
            "label": member.Alias,
            "icon": 'pi pi-user'
          });
        } else if (member.__type == 'Team:#MMCBODotNet48.WSData.Common') {
          let persons = [];
          member.Persons.forEach(person => {
            persons.push({
              "Id": member.Id,
              "label": person.Alias,
              "icon": 'pi pi-user'
            });
          });
          children.push({
            "Id": member.Id,
            "label": member.Name,
            "icon": 'pi pi-users',
            "children": persons
          });
        }
      });
      this.treeData.push({
        "label": instance.Name,
        "children": children
      });
    });
  }
  updateRowGroupMetaData() {
    this.rowGroupMetadata = {};
    if (this.allPerson) {
      for (let i = 0; i < this.allPerson.length; i++) {
        let rowData = this.allPerson[i];
        let teamname = rowData.TeamName;
        if (teamname != 'NA') {
          if (i == 0) {
            this.rowGroupMetadata[teamname] = {
              index: 0,
              size: 1
            };
          } else {
            let previousRowData = this.allPerson[i - 1];
            let previousRowGroup = previousRowData.TeamName;
            if (teamname === previousRowGroup) this.rowGroupMetadata[teamname].size++;else this.rowGroupMetadata[teamname] = {
              index: i,
              size: 1
            };
          }
        } else {
          this.rowGroupMetadata[teamname] = {
            index: i,
            size: 1
          };
        }
      }
    }
  }
  onDragEnd($event, node) {
    this.messageService.add({
      severity: 'info',
      summary: node.label + " removed"
    });
    let instance = this.treeData.find(x => x.label == node.parent.label);
    instance.children.splice(instance.children.findIndex(x => x.label == node.label), 1);
    let members = this.instancesTransport.find(x => x.Name == instance.label).Members;
    members.splice(members.findIndex(x => x.Id == node.Id), 1);
    //this.treeData.find(x => x.children.find(y => y.label === node.label) === node).children.splice(this.treeData.find(x => x.children.find(y => y.label === node.label) === node).children.findIndex(z => z.label === node.label), 1);
  }
  dragStartRight($event, rowData) {
    this.rowDataSelected = rowData;
  }
  onDrop($event, node) {
    if (this.rowDataSelected) {
      var addElement;
      var addInstanceTransport;
      if (this.rowDataSelected.TeamName == "NA") {
        addElement = {
          "Id": this.rowDataSelected.Id,
          "label": this.rowDataSelected.Alias,
          "icon": 'pi pi-user'
        };
        addInstanceTransport = {
          "__type": "Person:#MMCBODotNet48.WSData.Common",
          "Id": this.rowDataSelected.Id,
          "Name": this.rowDataSelected.Name,
          "Alias": this.rowDataSelected.Alias,
          "Email": this.rowDataSelected.Email
        };
      } else {
        let teamName = this.rowDataSelected.TeamName;
        let member = this.allPerson.filter(function (person) {
          return person.TeamName === teamName;
        });
        let children = [];
        let persons = [];
        member.forEach(mem => {
          children.push({
            "Id": mem.Id,
            "label": mem.Alias,
            "icon": 'pi pi-user'
          });
          persons.push({
            "Id": mem.Id,
            "Name": mem.Name,
            "Alias": mem.Alias,
            "Email": mem.Email
          });
        });
        addElement = {
          "Id": this.rowDataSelected.Id,
          "label": this.rowDataSelected.TeamName,
          "icon": 'pi pi-users',
          "children": children
        };
        addInstanceTransport = {
          "__type": "Team:#MMCBODotNet48.WSData.Common",
          "Id": this.rowDataSelected.TeamId,
          "Name": this.rowDataSelected.TeamName,
          "Persons": persons
        };
      }
      var instance;
      if (node.parent) {
        if (node.parent.parent) {
          instance = this.treeData.filter(obj => {
            return obj.label === node.parent.parent.label;
          });
        } else {
          instance = this.treeData.filter(obj => {
            return obj.label === node.parent.label;
          });
        }
      } else {
        instance = this.treeData.filter(obj => {
          return obj.label === node.label;
        });
      }
      let checkExist = instance[0].children.filter(obj => {
        return obj.label === addElement.label;
      });
      if (checkExist.length > 0) {
        this.messageService.add({
          severity: 'error',
          summary: addElement.label + " already exists"
        });
      } else {
        this.messageService.add({
          severity: 'info',
          summary: addElement.label + " added to instance " + instance[0].label
        });
        instance[0].children.push(addElement);
        this.instancesTransport.find(x => x.Name == instance[0].label).Members.push(addInstanceTransport);
      }
      this.rowDataSelected = null;
    }
  }
  BtnScript_Click() {
    var routingname = '';
    if (this.isImport && this.txtRoutingName != '') {
      // this.DEFAULTROUTING = tbkDefatultrouting.DataContext.ToString();
      routingname = this.txtRoutingName;
    } else {
      if (!this.cmbDefaultroutingSelectedItem) {
        this.DEFAULTROUTING = "0";
      } else {
        routingname = this.cmbDefaultroutingSelectedItem.Value.toString();
        this.DEFAULTROUTING = this.cmbDefaultroutingSelectedItem.ID.toString();
      }
    }
    if (routingname == '') {
      return;
    }
    let instancesTransport = this.instancesTransport;
    let pk_defaultrouting = parseInt(this.DEFAULTROUTING);
    let mode = "Script";
    let Loginname = this.ntusr;
    this.adminService.SaveDefaultInstanceMembers(instancesTransport, pk_defaultrouting, mode, Loginname).toPromise().then(r => {
      let instancememberScripts = '';
      if (r['instancememberScripts'] != '') {
        // str_Query = r['instancememberResult'];
        instancememberScripts = instancememberScripts.concat("Changes in the routing templates are: \n");
        instancememberScripts = instancememberScripts.concat("-- Modification in the routing template - " + routingname);
        instancememberScripts = instancememberScripts.concat('\n');
        instancememberScripts = instancememberScripts.concat(r['instancememberScripts']);
        this.TxtQueryWindow = instancememberScripts;
        //TxtQueryWindow.Text = instancememberScripts.ToString() + "\r\n" + "Rollback;";
      } else {
        this.messContent = "No changes in the Routing templates";
        this.messTitle = "Save Results";
        this.displayInfo = true;
      }
    });
  }
  BtnSave_Click() {
    let routingname = '';
    if (this.isImport && this.txtRoutingName != '') {
      // this.DEFAULTROUTING = tbkDefatultrouting.DataContext.ToString();
      routingname = this.txtRoutingName;
    } else {
      //if (cmbDefaultrouting.SelectedItem == null) { DEFAULTROUTING = "0"; } else { routingname = ((WebFlow.Admin.WSData.Configuration.DefaultRoutingTransport)cmbDefaultrouting.SelectedItem).DEFAULTROUTINGNAME.ToString(); DEFAULTROUTING = ((WebFlow.Admin.WSData.Configuration.DefaultRoutingTransport)cmbDefaultrouting.SelectedItem).PK_DEFAULTROUTING.ToString(); }
      if (!this.cmbDefaultroutingSelectedItem) {
        this.DEFAULTROUTING = "0";
      } else {
        routingname = this.cmbDefaultroutingSelectedItem.Value.toString();
        this.DEFAULTROUTING = this.cmbDefaultroutingSelectedItem.ID.toString();
      }
    }
    if (routingname == '') {
      return;
    }
    let instancesTransport = this.instancesTransport;
    let pk_defaultrouting = parseInt(this.DEFAULTROUTING);
    let mode = "";
    let Loginname = this.ntusr;
    this.adminService.SaveDefaultInstanceMembers(instancesTransport, pk_defaultrouting, mode, Loginname).toPromise().then(r => {
      let instancememberResult = '';
      if (r['instancememberResult'] != '') {
        instancememberResult = instancememberResult.concat("Changes in the routing templates are: \n");
        instancememberResult = instancememberResult.concat("-- Modification in the routing template - " + routingname);
        instancememberResult = instancememberResult.concat('\n');
        instancememberResult = instancememberResult.concat(r['instancememberResult']);
        this.TxtQueryWindow = instancememberResult;
      } else {
        this.messContent = "No changes in the Routing templates";
        this.messTitle = "Save Results";
        this.displayInfo = true;
      }
    });
  }
