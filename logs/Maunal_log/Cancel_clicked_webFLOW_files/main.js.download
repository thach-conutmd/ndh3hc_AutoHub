/** This is the combo box, which offers multiselection capabilities */
class LODMultiSelectComboBoxComponent extends src_app_util_UIElement_UIElement_component__WEBPACK_IMPORTED_MODULE_0__.UIElementComponent {
  // compared to original code, added (hard-coded) wait indicator styling replacing the LODMultiSelectComboBox.Animations and the Indicator UIElement
  static {
    this.waitIndicatorStyleNonLoading = {
      'opacity': '0',
      'float': 'right'
    };
  }
  static {
    this.waitIndicatorStyleLoading = {
      'animation-name': 'waitIndicatorFadeIn',
      'animation-duration': '0.075s',
      'opacity': '1',
      'float': 'right'
    };
  }
  static {
    this.waitIndicatorStyleJustLoaded = {
      'animation-name': 'waitIndicatorFadeOut',
      'animation-duration': '0.2s',
      'opacity': '0',
      'float': 'right'
    };
  }
  get ngWaitIndicatorStyle() {
    return this.waitIndicatorStyle;
  }
  // #endregion
  get borderStyle() {
    return {
      'background-color': !this.IsSoftEnabled ? "#eee" : this.LODMultiSelectComboBoxAnimation.InvalidBorderColor == "transparent" ? "#fff" : this.LODMultiSelectComboBoxAnimation.InvalidBorderColor
      //'height': '25px'
    };
  }
  /** Property introduced when porting: this will interact with LODComboBox.component.html, but offer
   *  less possibilities than the original approach.
   *  This simplification was done to save effort, and the potential use cases were analyzed and are
   *  expected to be complete with respect to the original webFLOW application. */
  get ItemAppearance() {
    return this._itemAppearance;
  }
  set ItemAppearance(value) {
    this._itemAppearanceValueOnTransport = value;
    switch (value) {
      case 'ValueOnly': // dropdown will only display a list of values
      case 'ValueWithId':
        // dropdown will display two columns for each value: id and value
        this._itemAppearance = value;
        break;
      default:
        this._itemAppearance = 'NotSupported';
        break;
    }
  }
  /**
   * Added when porting for primeNG p-multiselect: p-multiselect is able to display a default text in the
   * absence of a valid selection based on picked items.
   * So this can be used to display the value even if the available items have not yet been loaded.
   */
  get DefaultLabel() {
    if (this.LODSelectedItems && this.LODSelectedItems.length > 0) {
      const s = this.LODSelectedItems.map(element => {
        return element.Value;
      }).join("; ");
      return s + "; ";
    }
    return "---";
  }
  /** Constructor */
  constructor(cdr) {
    super();
    this.cdr = cdr;
