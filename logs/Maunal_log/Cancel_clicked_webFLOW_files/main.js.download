                      fileinfo.FileElementRevision = verCalibrationFile.objRevision;
  
                      ReadyState &= (~ReadyStates.AwaitingDSTContent);
                      CDMGetFileAttributes(CDMSessionKey, fileinfo);
                  }
              }
              catch (Exception x)
              {
                  ReadyState &= (~ReadyStates.AwaitingDSTContent);
                  Container.DisplayDefaultErrorBubble(FrameworkElement, CDMExceptionText(x));
              }
          }
  
  
