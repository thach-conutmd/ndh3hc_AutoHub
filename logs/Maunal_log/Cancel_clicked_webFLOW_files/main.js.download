/**
 * The default bridge for criterion descriptors
 * @typeparam B The type of business object
 */
class CriterionDescriptorDefaultDescriptorBridge {
  constructor(ctorTO, ctorBO) {
    this.ctorTO = ctorTO;
    this.ctorBO = ctorBO;
  }
  /**
   * Generates the transport
   * @param manager Manager, which is used for TransportObject generation
   * @param businessObject Business object to generate from
   * @returns The transport object
   */
  GenerateTransportObject(manager, businessObject) {
    const bo = businessObject;
    if (bo && typeof bo === 'object' && 'Data' in bo) {
      // ported to proceed similarly as in the original type check
      const transport = bo['Data']; // access protected member from bridge
      return transport;
    }
    throw new Error("Unable to generate Transport object for the criterion descriptor.");
  }
  /**
   * Generates business object from transport object
   * @param manager Manager, which is currently used for generation
   * @param transportObject Transport object, which should be transformed to the business object
   * @returns Generated business object
   */
  GenerateBusinessObject(manager, transportObject) {
    let to = transportObject;
    if (to && typeof to === 'object') {
      // original .NET type check cannot be ported
      if (!(to instanceof this.ctorTO)) {
        // added when porting: patch from JSON object data to real transport object
        // In the ported code, we are getting only native JavaScript Objects for the transport,
        // so functionality bound to transports would not be available.
        // This can turn out to be a major problem for all CriterionDescriptor<T> objects, since their data is mapped to a
        // transport, so if we want to use anything besides properties, this may cause problems -
        // the data would not be guaranteed to behave like the transport used in C#, since its
        // (proto)type would be missing.
        // So we try to resolve this here by rebridging to a real transport.
        const tmp = new this.ctorTO(); // Make a real transport ...
        Object.assign(tmp, transportObject); // ... and push the received properties to it ...
        const boData = manager.GenerateBusinessObject(tmp); // ... so we can call ourselves without recursing endlessly ...
        to = manager.GenerateTransportObject(boData); // ... and are finally able to obtain a real transport object to use as data.
      }
      const bo = new this.ctorBO();
      bo['_Data'] = to; // set private member from bridge
      return bo;
    }
    throw new Error("Unable to generate business object for the criterion descriptor."); // wasn't reached in original code and is now even less likely to be reached
  }
}

