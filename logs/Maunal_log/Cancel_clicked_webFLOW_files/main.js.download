  /**
   * Returns an iterator that iterates through the collection.
   * @returns An @see Iterator<IEntity> that can be used to iterate through the entities collection.
   */
  [Symbol.iterator]() {
    let pointer = 0;
    const entities = this.entities;
    return {
      next() {
        if (pointer < entities.length) {
          return {
            done: false,
            value: entities[pointer++]
          };
        } else {
          return {
            done: true,
            value: null
          };
        }
      }
    };
  }
}

