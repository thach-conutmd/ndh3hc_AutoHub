  cdmVersion_PreparationCompleted(sender, e) {
    try {
      let sError = "Unknown failure - no response when preparing file fetch.";
      const fileinfo = e;
      this.ReadyState &= ~ReadyStates.AwaitingPreparation;
      if (fileinfo) {
        this.CDMSessionKey = fileinfo.CDMSessionKey;
        if (fileinfo.Error) {
          sError = fileinfo.Error;
        } else if (!(sError = _FileListItemViewModel__WEBPACK_IMPORTED_MODULE_3__.FileListItemViewModel.CheckExistingFile(fileinfo.WFFileName, this.FileListItemViewModel, this.FileListItemViewModel.Parent.ContainerModel))) {
          this.confirmationService.confirm({
            accept: () => {
              this.CDMFetchFile(this.CDMSessionKey, fileinfo);
            },
            message: fileinfo.ConfirmationMessage,
            acceptLabel: 'OK',
            acceptVisible: true,
            rejectLabel: 'Cancel',
            rejectVisible: true,
            header: 'Fetching vCDM file',
            icon: 'pi .pi-info-circle'
          });
        }
      }
      if (sError) {
        this.DisplayDefaultErrorBubble(this.FrameworkElement, sError);
      }
    } catch (x) {
      this.ReadyState &= ~ReadyStates.AwaitingPreparation;
      this.DisplayDefaultErrorBubble(this.FrameworkElement, CDMItemsViewModel.CDMExceptionText(x));
    }
  }
