  handleFileImportXML(event) {
    if (event && event.target && event.target.files && event.target.files.length > 0) {
      this.xmlImportFile = event.target.files[0];
      //this.loadSecurityRelevantVersion();
      this.loadSecurityRelevantThirdParty();
      this.readFile(this.xmlImportFile);
    }
  }
  readFile(file) {
    let self = this;
    const reader = new FileReader();
    reader.onload = e => {
      var parser = new xml2js__WEBPACK_IMPORTED_MODULE_2__.Parser({
        trim: true,
        explicitArray: true
      });
      parser.parseString(e.target.result, function (err, result) {
        self.resetBasicParameters();
        self.resetDefaultTab();
        self.xmlDataImport = result;
        let xmlSecurityBom = result.SecurityBom;
        if (xmlSecurityBom) {
          // validation secBOM verison
          if (xmlSecurityBom.SystemInfomation) {
            var xmlSecBOMVersion = xmlSecurityBom.SystemInfomation[0].Version[0];
          }
          if (!xmlSecBOMVersion || xmlSecBOMVersion !== self.secBomVersion) {
            // show popup 
            self.isShowPopupVersionValidation = true;
          } else {
            self.doImportSecBOMXml();
          }
        }
      });
    };
    reader.readAsText(file);
  }
