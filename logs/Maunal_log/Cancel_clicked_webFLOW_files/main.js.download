/***/ 99414:
/*!*********************************************************************!*\
  !*** ./src/app/MMC.Swift.WSData/Fields/FieldCollectionTransport.ts ***!
  \*********************************************************************/
/***/ ((__unused_webpack_module, __webpack_exports__, __webpack_require__) => {

"use strict";
__webpack_require__.r(__webpack_exports__);
/* harmony export */ __webpack_require__.d(__webpack_exports__, {
/* harmony export */   FieldCollectionTransport: () => (/* binding */ FieldCollectionTransport)
/* harmony export */ });
/*
* Reviewer: Frank
* Reviewed: 28.09.2020
* Remarks : Ported code maps field-specific data from a list in the FieldCollectionTransport to
* each individual field transport or the other way round when bridging (originally when serializing/deserializing).
* This seems to work fine, but one must be aware that each piece of such FieldSpecificDataTransport can
* still be pure JSON after this remapping.
*/
/** This is the transport for the field collection */
class FieldCollectionTransport {
  constructor() {
    this.__type = "FieldCollection:#MMC.Swift.WSData.Net48.Fields";
    /** Fields of the collection */
    this.Fields = null;
    /**
     * Field specific data - they are attached back to fields after deserialization
     * AUTOMATIC FIELD - it is automatically created from the non-serializable parts of the field before serialization
     */
    this.FieldSpecificData = null;
  }
  /**
   * Ported to be called when bridged as [deserialized].
   * @param transport (JSON) to be deserialized
   */
  static OnDeserialized(transport) {
    // okay, now we have to populate fields with FieldSpecificData, if any
    // now let's glue FieldSpecificData in
    if (transport.FieldSpecificData) {
      // first create map of fields
      const fieldMap = {};
      for (let field of transport.Fields) {
        if (field.ControllerId) {
          let indexid = 0; //= field.Id + field.ControllerId;
          indexid = Number(field.Id.toString() + field.ControllerId.toString().padStart(2, "0"));
          fieldMap[Number(indexid)] = field;
        } else fieldMap[field.Id] = field;
      }
      for (let data of transport.FieldSpecificData) {
        if (data.ControllerId) {
          let indexid = 0;
          indexid = Number(data.FieldId.toString() + data.ControllerId.toString().padStart(2, "0"));
          const field = fieldMap[indexid];
          if (field) field.SpecificData = data;
        } else {
          const field = fieldMap[data.FieldId];
          if (field) field.SpecificData = data; // data is assumed to still be a pure JSON object; we hope it won't cause problems
        }
      }
      transport.FieldSpecificData = null;
    }
  }
  static pad(num, size) {
    let s = num + "";
    while (s.length < size) s = "0" + s;
    return s;
  }
  /**
   * Ported to be called when bridged as [serializing].
   * @param transport object to serialize to JSON
   */
  static OnSerializing(transport) {
    // make sure we have list of fields (if null is set, use empty list instead)
    if (!transport.Fields) transport.Fields = new Array();
    // now populate field specific data
    const lst = new Array();
    for (let field of transport.Fields) {
      if (field.SpecificData) {
        // ensure, that the ID is properly populated
        field.SpecificData.FieldId = field.Id;
        lst.push(field.SpecificData);
        field.SpecificData = null;
      }
    }
    if (lst.length > 0) transport.FieldSpecificData = lst;
  }
}

