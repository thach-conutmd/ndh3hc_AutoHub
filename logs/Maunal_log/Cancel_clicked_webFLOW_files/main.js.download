  cmbECUSecurity_Import() {
    if (!this.cmbECUSecuritySelectedItemTemp) return;
    var selectedECUSecurity = this.cmbECUSecuritySelectedItemTemp;
    const sercurityBCId = selectedECUSecurity.ID;
    this.webFlowService.GetSecurityGroup(sercurityBCId).subscribe(data => {
      this.selectedSecurityBOM = {
        SecurityBC: {
          ...selectedECUSecurity
        },
        SecurityGroup: []
      };
      if (data.SecurityGroups && data.SecurityGroups.length > 0) {
        if (data.CategoryExtendMenu && data.CategoryExtendMenu.length > 0) {
          this.categoryExtendMenu = data.CategoryExtendMenu.map(s => ({
            ID: s.ID,
            Value: s.Name,
            IsShowWhat: s.IsShowWhat
          }));
        }
        this.handleSecurityGroupImport(data);
      }
    });
  }
