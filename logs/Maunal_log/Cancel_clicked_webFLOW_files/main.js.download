  cmbECUSecurity_SelectionChanged(event) {
    const sercurityBCId = event.value.ID;
    this.webFlowService.GetSecurityGroup(sercurityBCId).subscribe(data => {
      const getSecBOMSecurityGroup = src_app_MMC_Swift_TransportBridging_Interfaces_ITransportBridgesManager__WEBPACK_IMPORTED_MODULE_0__.TransportBridging.CurrentTransportBridgesManager.GenerateBusinessObject(data);
      this.selectedSecurityBOM = {
