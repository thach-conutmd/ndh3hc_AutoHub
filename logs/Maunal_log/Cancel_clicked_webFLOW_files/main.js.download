/* harmony export */ });
/*
* Reviewer: Frank
* Reviewed: 06.11.2019
* * */
class FileList {
  /**
   * Get FileListItem by fileClassID
   * @param fileClassID The id for the @see FileListItem to get
   * @returns The @see FileListItem corresponding to the given fileClassID or undefined
   */
  get(fileClassID) {
    // ported the following expression:
    // return this.Items.Where(x => x.FileClassID.ToUpper() == fileClassID.ToUpper()).SingleOrDefault();
    let result = undefined;
    this.Items.filter(fli => {
      if (fli.FileClassID.toUpperCase() === fileClassID.toUpperCase()) {
        if (result) throw new Error("Found multiple FileListItems for fileClassID='" + (fileClassID || '') + "'.");
        result = fli;
      }
    });
    return result;
  }
  constructor() {
    this.ID = 0;
    this.Items = new Array();
  }
}

