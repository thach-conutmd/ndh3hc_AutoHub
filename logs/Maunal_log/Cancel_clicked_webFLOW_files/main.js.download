  showChangesModal() {
    if (this.preSelectedSecurityBOM && this.cmbECUSecuritySelectedItemTemp && this.cmbECUSecuritySelectedItemTemp.Value && this.preSelectedSecurityBOM.SecurityBC && this.preSelectedSecurityBOM.SecurityBC.Value) {
      this.fieldChanges = [];
      this.displayCompareModal = true;
      this.compareChange();
    }
  }
  compareChange(xmlGroup) {
    if (this.preSelectedSecurityBOM) {
      this.fieldChanges = [];
      if (this.preSelectedSecurityBOM.SecurityBC.Value !== this.selectedSecurityBOM.SecurityBC.Value) {
        let fieldChange = {
          Usecase: "",
          Feature: ""
        };
        this.fieldChanges.push(fieldChange);
        return;
      }
      this.secbomGroupComponents.forEach(s => {
        const securityGroupNew = s.securityGroupChangedItem();
        let securityGroupOld = null;
        if (xmlGroup) {
          securityGroupOld = xmlGroup.find(s => s.Name === securityGroupNew?.Name);
        } else {
          securityGroupOld = this.preSelectedSecurityBOM.SecurityGroup.find(s => s.Name === securityGroupNew?.Name);
        }
        securityGroupNew.Features.forEach(newFeature => {
          let oldFeature = securityGroupOld.Features.find(f => f.Name == newFeature.Name);
          if (!(newFeature.ActivationStatus.Value == oldFeature.ActivationStatus.Value && newFeature.ActivationStatus.Value == "Not_Enabled")) {
            let differences = diff(oldFeature, newFeature);
            differences.forEach(dif => {
              if (!(dif.path.includes("IsModified") || dif.path.includes("ExtendMenuItems") && dif.type == "A" && dif.rhs?.SelectedCategories?.length == 0)) {
                let fieldChange = {
                  Usecase: "",
                  Feature: ""
                };
                if (dif.path) {
                  fieldChange.Usecase = securityGroupOld.Name;
                  fieldChange.Feature = newFeature.Name;
                }
                if (this.fieldChanges.filter(function (e) {
                  return e.Feature === fieldChange.Feature;
                }).length <= 0) {
                  this.fieldChanges.push(fieldChange);
                }
              }
            });
          }
        });
      });
    }
  }
  reset() {
    this.resetDefaultTab();
    this.resetBasicParameters();
    this.resetSecurityGroups();
  }
  resetDefaultTab() {
    this.tabID = this.generalTabID;
  }
  resetBasicParameters() {
    this.pverValue = "";
    this.cSecMValue = "";
    this.cmbControllerCategorySelectedItem = null;
    //this.softwareInfoTable.forEach(s => s.Value = "");
    //this.securityRelevantVersionArray.forEach(s => s.Value = "");
    this.securityRelevantVersionArray = [{
      Value: "",
      Label: "<<Manual input BC:CycurHSM/xxxx.x;>>"
    }];
    ;
    //this.hardwareInfoArray.forEach(s => s.Value = "");
    this.sercurityCaseArray.forEach(s => s.Value = "");
    this.connectivityFeatureArray.forEach(s => {
      s.Value = false;
      s.AdditionalValue = null;
    });
    this.projectSpecificValue = [];
    this.securityThirdPartyVersionData = [];
  }
  resetSecurityGroups() {
    if (!this.selectedSecurityBOM) return;
    //reset security group            
    this.selectedSecurityBOM = JSON.parse(JSON.stringify(this.selectedSecurityBOM));
    this.selectedSecurityBOM.SecurityGroup.forEach(securityGroup => {
      //reload feature
      securityGroup.Features.forEach(feature => {
        feature.ActivationStatus = {
          ...feature.PreSelectedActivationStatus
        };
        //extend menu
        // if (feature.ExtendMenuItems)
        //     feature.ExtendMenuItems.SelectedCategories = [];
        //reload category
        feature.CryptoCategories.forEach(category => {
          delete category.AdditionalValue;
          delete category.FromWho;
          delete category.What;
          // if (category.IsShowHideCryptoValue)
          delete category.IsShowCryptoValue;
          if (category.CategoryExtendMenu) category.CategoryExtendMenu = null;
          if (category.IsCheckBoxShowWhat) {
            delete category.IsCheckBoxShowWhat;
            category.CryptoDataSource.forEach(c => {
              delete c.IsSelected;
            });
          }
          if (category.PreSelectedValue) category.CryptoValue = {
            ...category.PreSelectedValue
          };else category.CryptoValue = null;
        });
        // reset IsModified
        feature.IsModified = false;
      });
    });
  }
  fileInputSecBomXMLClickEvent() {
    let elm = document.getElementById("fileInputSecBomXML");
    if (elm) {
      elm.value = "";
      elm.click();
    }
  }
  handleExpandCollapseAll() {
    this.isExpandCollapseAll = !this.isExpandCollapseAll;
    if (this.isExpandCollapseAll) {
      this.labelExpandCollapse = "Collapse All";
    } else {
      this.labelExpandCollapse = "Expand All";
    }
  }
  handleDeleteThirdPartyVersion(i) {
    this.securityThirdPartyVersionData.splice(i, 1);
  }
  addOneSecurityThirdPartyVersion() {
    var data = {
      Value: "",
      Description: "",
      ProductName: "",
      Vendor: "",
      VendorPackageIdentification: "",
      VendorPackageVersion: ""
    };
    this.securityThirdPartyVersionData.push(data);
  }
  handleDeleteSecurityRelevantVersion(i) {
    this.securityRelevantVersionArray.splice(i, 1);
  }
  addOneSecurityRelevantVersion() {
    this.securityRelevantVersionArray.push({
      Value: "",
      Label: "<<BC:xxxxxxx/xxxx.x;>>"
    });
  }
  handleAutoFillPVER(PVERValue) {
    if (PVERValue) {
      PVERValue += '';
      // this.webFlowService.GetSecBOMDataPVER(PVERValue).subscribe(data => {
      //     if (data) {
      //         this.securityRelevantVersionArray = [{ Value: "", Label: "<<Manual input BC:CycurHSM/xxxx.x;>>" }];
      //         data.ListDataPver.forEach(value => {
      //             this.securityRelevantVersionArray.push({ Value: value, Label: "" });
      //         });
      //     }
      //     alert("Load data from PVER successfull");
      //     this.isShowLoadingScreen = false;
      // },
      //     (error) => {
      //         //console.log(error);
      //         alert("Load data from PVER failed. Please check PVER and try again!");
      //         this.isShowLoadingScreen = false;
      //     }
      // );
      //this.webFlowService.GetSecBOMDataPVER(PVERValue).subscribe(data => {
      const trimPVERValue = PVERValue.replace(/\s/g, '');
      if (trimPVERValue.indexOf(':') <= 0 || trimPVERValue.indexOf('/') <= 0 || trimPVERValue.indexOf(';') <= 0) return;
      this.isShowLoadingScreen = true;
      const className = trimPVERValue.split(':')[0];
      const pverWithoutClassName = trimPVERValue.split(':')[1];
      const componentName = pverWithoutClassName.split('/')[0];
      const variantName = pverWithoutClassName.split('/')[1].split(';')[0];
      const revision = parseInt(pverWithoutClassName.split('/')[1].split(';')[1]);
      this.sbomService.GetSBOMComponent(className, componentName, variantName, revision).subscribe(data => {
        if (data.SoftwareComponent3rdParty == null || data.PVERValue == null && data.SoftwareComponent3rdParty?.length == 0) {
          this.showComponentMissingDialog = true;
          this.errorMessageForComponentMissing = "Error with connection to SDOM / DWH, please try again later";
        } else if (data.PVERValue && data.SoftwareComponent?.length == 0) {
          this.showComponentMissingDialog = true;
          this.errorMessageForComponentMissing = "Missing BC/FC information for given PVER from DWH";
        } else if (data.SoftwareComponent3rdParty) {
          this.setThirdPartyValueFromSDOM(data.SoftwareComponent3rdParty);
          alert("Load data from PVER successfull");
        }
        this.isShowLoadingScreen = false;
      }, error => {
        //console.log(error);
        alert("Load data from PVER failed. Please check PVER and try again!");
        this.isShowLoadingScreen = false;
      });
      this.stopLoadingService();
    } else {
      alert("Please input the PVER to continue!");
    }
  }
  isManualInput(vendor) {
    return !vendor || vendor.trim().length === 0;
  }
  goToError(code) {
    const element = document.getElementById('vendor_' + code);
    console.log(element);
    if (element) {
      element.scrollIntoView({
        behavior: 'smooth',
        block: 'center'
      });
      element.classList.remove('manual-input-row');
      element.classList.add('highlight-row');
      setTimeout(() => {
        element.classList.remove('highlight-row');
        element.classList.add('manual-input-row');
      }, 3000);
    }
  }
  stopLoadingService() {
    this.loadingScreenService.stopLoading();
  }
  setThirdPartyValueFromSDOM(thirdPartyValues) {
    this.securityRelevantVersionArray = [];
    thirdPartyValues.forEach(value => {
      var data = {
        Value: value,
        Description: "",
        ProductName: "",
        Vendor: "",
        VendorPackageIdentification: "",
        VendorPackageVersion: ""
      };
      if (!this.securityThirdPartyVersionData.find(s => s.Value === value)) {
        this.securityThirdPartyVersionData.push(data);
      }
    });
  }
  openSecBOMXMLFromWebFlowJob() {
    this.loadSecurityRelevantThirdParty();
    this.fetchDataFromSecBomFile(this.fileSource);
  }
  fetchDataFromSecBomFile(file) {
    let self = this;
    const reader = new FileReader();
    reader.onload = e => {
      var parser = new xml2js__WEBPACK_IMPORTED_MODULE_2__.Parser({
        trim: true,
        explicitArray: true
      });
      parser.parseString(e.target.result, (err, result) => {
        self.xmlDataImport = result;
        self.doImportSecBOMXml();
      });
    };
    reader.readAsText(file);
  }
