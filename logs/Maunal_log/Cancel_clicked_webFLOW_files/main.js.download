   * @param id The identifier.
   * @param value The value.
   * @param properties The properties.
   */
  constructor(id, value, properties) {
    super();
    this.ID = id;
    this.Value = value;
    this.Properties = properties;
  }
  /**
   * Returns a string that represents this instance.
   * @returns A string that represents this instance.
   */
  toString() {
