/** This is the parameter in the markup */
class Parameter {
  /**
   * This is the domain of the parameter (parameter identifier consists of Domain.Name)
   * (if it is not named, this value is null)
   * (if it is named, but no domain specified, this value is String.Empty)
   */
  get Domain() {
    return this._Domain;
  }
  /** Name of the parameter (if it is not named, this value is null) */
  get Name() {
    return this._Name;
  }
  /** This is the full name of the parameter */
  get FullName() {
    return this._FullName;
  }
  /**
   * This is the first token of the parameter
   * It may be null (if parameter wasn't constructed from parsing)
   */
  get LeadToken() {
    return this._LeadToken;
  }
  /** Indicates whether the parameter has name */
  get HasName() {
    return !(0,src_app_System_String__WEBPACK_IMPORTED_MODULE_0__.IsNullOrEmpty)(this.Name);
  }
  /** Value of the parameter */
  get Value() {
    return this._Value;
  }
