  GenerateBusinessObject(manager, transportObject) {
    const bo = new this.ctorBO();
    bo.Data = transportObject;
    bo.OldCondition = manager.GenerateBusinessObject(transportObject.OldCondition);
    bo.Condition = manager.GenerateBusinessObject(transportObject.Condition);
    return bo;
  }
}

