  if (ctorValue) {
    if (value instanceof ctorValue) return true; // if we are an instance of an additionally passed constructor, it's fine: type successfully validated
    if (ctorValue === Boolean) return typeof value === 'boolean';
    if (ctorValue === Number) return typeof value === 'number';
    if (ctorValue === String) return typeof value === 'string';
  }
  const t = typeof value;
  if (t === 'string' || t === 'number' || t === 'boolean') return true; // otherwise, in a relaxed manner, accept any basic value type
  return false;
}

