    var iData = this.descriptor.InitializationData;
    if (iData.DataSourceProvider.AvailableValues != null) {
      // now create items from DataSource
      if (this.isVAGFilter) {
        this.items = iData.DataSourceProvider.AvailableValues.filter(item => item.JobId != this.vagFilter.JobId);
      } else if (this.isFieldFixFilter) {
        this.items = iData.DataSourceProvider.AvailableValues.filter(item => item.JobId != this.fieldFixFilter.JobId);
