    if (xmlSecurityBom.ConnectivityFeatures && xmlSecurityBom.ConnectivityFeatures[0]) {
      let xmlConnectivityFeatures = xmlSecurityBom.ConnectivityFeatures[0].ConnectivityFeature;
      if (xmlConnectivityFeatures && xmlConnectivityFeatures.length > 0) {
        xmlConnectivityFeatures.forEach(connectivityFeature => {
          let idx = this.connectivityFeatureArray.findIndex(s => s.Name === connectivityFeature.$?.Name);
          if (idx > -1 && this.connectivityFeatureArray[idx]) {
            if (connectivityFeature.AdditionalValue) {
