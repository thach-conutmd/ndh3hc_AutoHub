      this.FK_CFG_GCA = res.FK_CFG_GCA;
      this.lstRoutings = [...this.rightbind];
    });
  }
  cmbECUGen_SelectionChanged() {
    if (!this.isECUGenOpen) {
      try {
        this.cmbBrandItemsSource = null;
        this.LoadBrand();
        this.cmbECUtypeItemsSource = null;
        this.cmbCustomerGroupItemsSource = null;
        this.cmbWorkingmodeItemsSource = null;
      } catch (ex) {
        throw ex;
      }
    }
  }
  cmbBrand_SelectionChanged() {
    if (!this.isBrandOpen) {
      try {
        this.LoadEcutype();
        this.cmbCustomerGroupItemsSource = null;
        this.cmbWorkingmodeItemsSource = null;
