  LoadDefaultRouting() {
    this.cmbECUGenSelectedItem ? this.ECUGEN = this.cmbECUGenSelectedItem.ID.toString() : null;
    this.cmbBrandSelectedItem ? this.BRAND = this.cmbBrandSelectedItem.ID.toString() : null;
    this.cmbECUtypeSelectedItem ? this.ECUTYPE = this.cmbECUtypeSelectedItem.ID.toString() : null;
    this.cmbCustomerGroupSelectedItem ? this.CUSTOMERGROUP = this.cmbCustomerGroupSelectedItem.ID.toString() : null;
    this.cmbWorkingmodeSelectedItem ? this.WORKINGMODE = this.cmbWorkingmodeSelectedItem.ID.toString() : null;
    this.adminService.Getcfg_gca_defaultrouting(this.ECUGEN, this.BRAND, this.ECUTYPE, this.CUSTOMERGROUP, this.WORKINGMODE).subscribe(res => {
      let cfgFields = [];
      res.DefaultRouting.forEach(dr => {
        cfgFields.push(src_app_MMC_Swift_TransportBridging_TransportBridgesManager__WEBPACK_IMPORTED_MODULE_2__.TransportBridgesManager.Current.GenerateBusinessObject(dr));
      });
      for (let i = 0; i < this.rightbind.length; i++) {
        for (let j = 0; j < cfgFields.length; j++) {
          if (cfgFields[j].DEFAULTROUTINGNAME == this.rightbind[i]) {
            this.rightbind.splice(i, 0);
          }
        }
      }
      for (let lststrcnt = 0; lststrcnt < cfgFields.length; lststrcnt++) {
        if (cfgFields[lststrcnt].DEFAULTROUTINGNAME != "WebFlow_Internal_Testing") {
          if (this.leftbind.indexOf(cfgFields[lststrcnt].DEFAULTROUTINGNAME) < 0) {
            this.leftbind.push(cfgFields[lststrcnt].DEFAULTROUTINGNAME);
          }
        }
      }
