          private Action<string, object> ExecutionTask = null;
          private object ExecutionParam = null;
          internal protected void CDMLoginAndExecute(Action<string, object> methodWithSessionKeyAndParam, object param)
          {
              if ((ReadyState & (ReadyStates.AwaitingLogin | ReadyStates.AwaitingSession)) != ReadyStates.Ready)
              {
                  if (ExecutionTask != null)
                  {
                      throw new System.InvalidOperationException("Already busy with a task. " +
                                  "This should never happen, please contact the developers.");
                  }
              }
              try
              {
                  //Container.DisplayDefaultWaitIndicator(FrameworkElement);
                  ExecutionTask = methodWithSessionKeyAndParam;
                  ExecutionParam = param;
  
                  if (string.IsNullOrEmpty(CDMSessionKey))
                  {
                      ReadyState |= ReadyStates.AwaitingLogin;
                      LoginRequestType login = new LoginRequestType();
                      login.DomainName = "CDM";
                      login.UserName = CDMUser;
                      login.PassWord = CDMPassword;
                      CDMSessionClient.LoginCompleted +=
                                  new EventHandler<LoginCompletedEventArgs>(cdmSession_LoginCompleted);
                      CDMSessionClient.LoginAsync(login);
                  }
                  else
                  {
                      ReadyState |= ReadyStates.AwaitingSession;
                      GetSessionStateRequestType session = new GetSessionStateRequestType();
                      session.sesHandle = CDMSessionKey;
                      CDMSessionClient.GetSessionStateCompleted +=
                                  new EventHandler<GetSessionStateCompletedEventArgs>(cdmSession_GetSessionStateCompleted);
                      CDMSessionClient.GetSessionStateAsync(session);
                  }
              }
              catch (Exception x)
              {
                  ReadyState &= (~(ReadyStates.AwaitingLogin | ReadyStates.AwaitingSession));
                  Container.DisplayDefaultErrorBubble(FrameworkElement, x.ToString());
              }
          }
  
          private void cdmSession_LoginCompleted(object sender, LoginCompletedEventArgs e)
          {
              try
              {
                  CDMSessionClient.LoginCompleted -=
                              new EventHandler<LoginCompletedEventArgs>(cdmSession_LoginCompleted);
                  LoginResponseType login = e.Result;
                  string sessionHandle = login.sesHandle;
                  if (!(sessionHandle.Contains("FAULT") || string.IsNullOrWhiteSpace(sessionHandle)))
                  {
                      CDMSessionKey = sessionHandle;
                      ReadyState &= (~ReadyStates.AwaitingLogin);
                      if (ExecutionTask != null)
                      {
                          ExecutionTask(sessionHandle, ExecutionParam);
                      }
                  }
                  else
                  {
                      CDMSessionKey = "";
                      ReadyState &= (~ReadyStates.AwaitingLogin);
                      Container.DisplayDefaultErrorBubble(FrameworkElement,
                                  "Login to CDM failed. Received sesssion handle: '" + sessionHandle + "'");
                  }
              }
              catch (Exception x)
              {
                  CDMSessionKey = "";
                  ReadyState &= (~ReadyStates.AwaitingLogin);
                  Container.DisplayDefaultErrorBubble(FrameworkElement, CDMExceptionText(x));
              }
          }
  
  
          private void cdmSession_GetSessionStateCompleted(object sender, GetSessionStateCompletedEventArgs e)
          {
              try
              {
                  CDMSessionClient.GetSessionStateCompleted -=
                              new EventHandler<GetSessionStateCompletedEventArgs>(cdmSession_GetSessionStateCompleted);
                  SessionStateType session = e.Result.sessionState;
                  if (session == SessionStateType.Valid)
                  {
                      ReadyState &= (~ReadyStates.AwaitingSession);
                      if (ExecutionTask != null)
                      {
                          ExecutionTask(CDMSessionKey, ExecutionParam);
                      }
                  }
                  else
                  {
                      CDMSessionKey = "";
                      Action<string, object> task = ExecutionTask;
                      ReadyState &= (~ReadyStates.AwaitingSession);
                      if (task != null)
                      {
                          ExecutionTask = null;
                          CDMLoginAndExecute(task, ExecutionParam);
                      }
                  }
              }
              catch (Exception x)
              {
                  ReadyState &= (~ReadyStates.AwaitingSession);
                  Container.DisplayDefaultErrorBubble(FrameworkElement, CDMExceptionText(x));
              }
          }
  
  
          internal protected void CDMGetSelectedItemAttributes(string sessionKey, object data)
          {
              try
              {
                  ReadyState |= ReadyStates.AwaitingDSTAttributes;
                  CDMFileInfoBuilder fileinfo = (CDMFileInfoBuilder)data;
                  GetVersionAttributesRequestType fetch = new GetVersionAttributesRequestType();
                  fetch.sesHandle = sessionKey;
                  fetch.versionNo = fileinfo.DSTVersionNumber;
                  CDMVersionClient.GetVersionAttributesCompleted +=
                              new EventHandler<GetVersionAttributesCompletedEventArgs>(cdmVersion_GetDSTAttributesCompleted);
                  CDMVersionClient.GetVersionAttributesAsync(fetch, fileinfo);
              }
              catch (Exception x)
              {
                  ReadyState &= (~ReadyStates.AwaitingDSTAttributes);
                  Container.DisplayDefaultErrorBubble(FrameworkElement, x.ToString());
              }
          }
  
          void cdmVersion_GetDSTAttributesCompleted(object sender, GetVersionAttributesCompletedEventArgs e)
          {
              try
              {
                  CDMVersionClient.GetVersionAttributesCompleted -=
                              new EventHandler<GetVersionAttributesCompletedEventArgs>(cdmVersion_GetDSTAttributesCompleted);
                  CDMFileInfoBuilder fileinfo = (CDMFileInfoBuilder)e.UserState;
                  string sError="";
  
                  switch (fileinfo.FileType)
                  {
                      case CDMFileTypes.CalibrationFile:
                          string sFileClass = "HEX";
                          string sFoundCustHex = "";
                          foreach (CDMVersionService.AttrMapEntryType amet in e.Result)
                          {
                              if (amet.key.ToUpperInvariant() == "USE_CUSTHEX")
                              {
                                  foreach (string s in amet.valuesArr)
                                  {
                                      if ((s.ToUpperInvariant() == "YES") || ((s.ToUpperInvariant() == "NO")))
                                      {
                                          if (s.ToUpperInvariant() == "YES")
                                          {
                                              sFileClass = "CUST_HEX";
                                          }
                                          else
                                          {
                                              sFileClass = "HEX";
                                          }
                                          sFoundCustHex += sFileClass + ";";
                                      }
                                  }
                              }
                          }
                          if (!string.IsNullOrEmpty(sFoundCustHex))
                          {
                              sFoundCustHex = sFoundCustHex.Substring(0, sFoundCustHex.Length - 1);
                              string[] arrsParts = sFoundCustHex.Split(';');
                              foreach (string s in arrsParts)
                              {
                                  if ((s != sFileClass) && (!string.IsNullOrWhiteSpace(s)))
                                  {
                                      sError = "Problem in CDM with selected DST: " +
                                                  "Found use_CustHex attribute on DST with mutiple, contradicting values. " +
                                                  "Please check the attribute in CDM system and correct.";
                                      break;
                                  }
                              }
                          }
                          fileinfo.FileClass = sFileClass;
                          break;
  
                      default:
                          sError = "Unknown CDM file type detected: " + fileinfo.FileType.ToString() +
                                      ". Please contact the developers.";
                          break;
                  }
  
                  ReadyState &= (~ReadyStates.AwaitingDSTAttributes);
  
                  if (!string.IsNullOrWhiteSpace(sError))
                  {
                      Container.DisplayDefaultErrorBubble(FrameworkElement, sError);
                  }
                  else
                  {
                      CDMGetFileElement(CDMSessionKey, fileinfo);
                  }
              }
              catch (Exception x)
              {
                  ReadyState &= (~ReadyStates.AwaitingDSTAttributes);
                  Container.DisplayDefaultErrorBubble(FrameworkElement, CDMExceptionText(x));
              }
          }
  
  
