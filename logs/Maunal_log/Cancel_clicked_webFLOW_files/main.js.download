      return Result.CreateSuccessResult();
    }
    // Compress value (Remove all whitespace characters)
    if (validateCompressed) {
      value = this.Compress(value);
    }
    const regex = /^0x(?:(([0-9A-F][0-9A-F])+))$/gi;
    const result = regex.exec(value);
    if (result && result.length > 0) {
      if (length !== null && length !== undefined) {
        const bytes = result[1]; // ##### desired group is assumed to be group 1 in JavaScript, please verify and rework if necessary
        const bytesLength = Math.floor(bytes.length / 2);
        if (bytesLength != length) {
          return Result.CreateErrorResult("Invalid HEX number length");
        }
      }
    } else {
      return Result.CreateErrorResult("Invalid HEX number");
    }
    return Result.CreateSuccessResult();
  }
  /**
   * Validate exact length of string value
   * @param value
   * @returns
   */
  static ValidateExactLength(value, length, customErrorMessage = undefined, validateCompressed = false) {
    if ((0,src_app_System_String__WEBPACK_IMPORTED_MODULE_0__.IsNullOrEmpty)(value)) {
