    } else {
      this.selectedRows = this.selectedRows.filter(sr => {
        if (sr.Id !== im.Id) {
          return sr;
        }
      });
      this.instancesTransport = this.instancesTransport.map(it => {
        it.Members = it.Members.filter(mem => {
          if (mem.Id !== toPerson.Id) {
            return mem;
          }
        });
        return it;
      });
    }
