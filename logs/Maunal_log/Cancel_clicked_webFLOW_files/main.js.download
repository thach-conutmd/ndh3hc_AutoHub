      case this.BC_Debug_DE:
        return "DEV-DE";
      case this.BC_Test:
        return "TEST";
      case this.BC_Integration:
        return "INTEGRATION";
      case this.BC_Configuration:
        return "CONFIGURATION";
      case this.BC_Release:
        return "RELEASE";
      default:
        return "Unknown";
    }
  }
