        pnvm.IsValid = true;
      }
      hsNumbers.add(pnvm.Number);
      if (pnvm.IsValid) {
        for (let availableNo of this.AvailableItems) {
          if (availableNo.Number === pnvm.Number) {
            pnvm.NumberValidationMessage = "'" + pnvm.Number + "' is already exists in 'Available numbers' pool";
