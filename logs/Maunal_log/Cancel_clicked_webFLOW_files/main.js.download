class BaseValidityInformation {
  /**
   * Changes the validity.
   * @param isValid Validity to be changed to
   * @param invalidReason Reason, why the field is invalid
   */
  ChangeValidity(isValid, invalidReason) {
    let oldIsValid = this.IsValid;
    let oldInvalidReason = this.InvalidReason;
    //set new validity information
    this.IsValid = isValid;
    this.InvalidReason = invalidReason;
    if (oldIsValid != isValid || oldInvalidReason != invalidReason) {
      this.IsValidChanged = true;
      this.SetFieldDirty();
    }
  }
  /**Sets the field dirty */
  SetFieldDirty() {}
  /**
   * Make field invalid
   * @param invalidReason Reason why the field is invalid
   */
  MakeInvalid(invalidReason) {
    this.ChangeValidity(false, invalidReason);
  }
  /**Make field valid */
  MakeValid() {
    this.ChangeValidity(true, "");
  }
  /**
   * Copy validity information
   * @param validity Validity information to copy from
   */
  CopyFrom(validity) {
    this.ChangeValidity(validity.IsValid, validity.InvalidReason);
  }
}

