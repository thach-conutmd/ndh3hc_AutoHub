  securityGroupTabOnclick(tabId) {
    this.tabID = tabId;
  }
  getSecurityGroupById(itemId) {
    if (this.selectedSecurityBOM) {
      return this.selectedSecurityBOM.SecurityGroup.find(s => s.ID == itemId);
    }
    return null;
  }
  exportXML() {
    if (!this.cmbECUSecuritySelectedItemTemp || this.cmbECUSecuritySelectedItemTemp.ID < 0) return;
    this.vendorMissingList = this.securityThirdPartyVersionData.filter(data => data.Vendor === "");
    if (this.vendorMissingList.length > 0) {
      this.showVendorMissingDialog = true;
      return;
    }
    const xmlObj = {
      SecurityBom: {
        SystemInfomation: {
          Version: this.secBomVersion
        },
        SecurityBC: {
          _: this.cmbECUSecuritySelectedItemTemp?.Value
        },
        ControllerCategory: {
          _: this.cmbControllerCategorySelectedItem ? this.cmbControllerCategorySelectedItem.Value : ""
        },
        // SoftwareInfos: {
        //     SoftwareInfo: []
        // },
        SecurityRelevantVersions: {
          SecurityRelevantVersion: []
        },
