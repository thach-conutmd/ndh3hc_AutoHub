/***/ 43049:
/*!**************************************************************!*\
  !*** ./src/app/WebFlow.WSData/Fields/PDTContainerCapsule.ts ***!
  \**************************************************************/
/***/ ((__unused_webpack_module, __webpack_exports__, __webpack_require__) => {

"use strict";
__webpack_require__.r(__webpack_exports__);
/* harmony export */ __webpack_require__.d(__webpack_exports__, {
/* harmony export */   PDTContainerCapsule: () => (/* binding */ PDTContainerCapsule)
/* harmony export */ });
/*
* Reviewer: Frank
* Reviewed: 08.09.2020
*/
// changed to transport and bridging approach from WebFlow.WSData\PDT\PDTContainerCapsule.cs when porting
// This class is the main equivalent for WebFlow.WSData\PDT\PDTContainerCapsule.cs
class PDTContainerCapsule {
  // merged multiple constructors into single constructor when porting
  constructor(or, availableWF_CDM_Elements) {
    this.DirtyBundles = new Set();
    if (or !== null && or !== undefined) {
      this.OperationResult = or;
    }
    if (availableWF_CDM_Elements !== null && availableWF_CDM_Elements !== undefined) {
      this.dicAvailableWF_CDM_Elements = availableWF_CDM_Elements;
    }
  }
  get AvailableWF_CDM_Elements() {
    if (!this.dicAvailableWF_CDM_Elements) return new Array();
    if (!this.lstAvailableWF_CDM_Elements) {
      this.lstAvailableWF_CDM_Elements = new Array();
      for (let item of this.dicAvailableWF_CDM_Elements.values()) {
        this.lstAvailableWF_CDM_Elements.push(item);
      }
    }
    return this.lstAvailableWF_CDM_Elements;
  }
  set AvailableWF_CDM_Elements(value) {
    this.lstAvailableWF_CDM_Elements = undefined;
    this.dicAvailableWF_CDM_Elements = undefined;
    if (value) {
      const dic = new Map();
      for (let element of value) {
        if (dic.has(element.Key)) throw new Error('Element "' + element.Key + '" already present.'); // added when porting as replacement for C#'s native error thrown on attempting to add a duplicate via Dictionary<string, PDT_PIDC_Element_vCDM>.Add(...)
        dic.set(element.Key, element);
      }
      this.dicAvailableWF_CDM_Elements = dic;
    }
  }
}

