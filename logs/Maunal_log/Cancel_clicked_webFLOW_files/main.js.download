  /**
   * Generates the transport
   * @param manager Manager, which is used for TransportObject generation
   * param businessObject Business object to generate from
   * @returns The transport object
   */
  GenerateTransportObject(manager, businessObject) {
    const result = businessObject.Data;
    result.OldCondition = manager.GenerateTransportObject(businessObject.OldCondition);
    result.Condition = manager.GenerateTransportObject(businessObject.Condition);
    return result;
  }
  /**
   * Generates business object from transport object
   * @param manager Manager, which is currently used for generation
   * @param transportObject Transport object, which should be transformed to the business object
   * @returns Generated business object
