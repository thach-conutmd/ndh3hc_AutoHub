/** Validation result class */
class Result {
  /** Gets validation result */
  get Success() {
    return this._Success;
  }
  /** Gets validation error message */
  get Error() {
    return this._Error;
  }
  // changed private constructor when porting to to have parameters for initializing private members
  constructor(success, error) {
    this._Success = success;
    this._Error = error;
  }
  /**
   * Creates sucessful validation result
   * @returns standard success result
   */
  static CreateSuccessResult() {
    return new Result(true, undefined);
  }
  /**
   * Creates error validation result
   * @param error error message
   * @returns error result with the specified error message
   */
  static CreateErrorResult(error) {
    return new Result(false, error);
  }
}
/** Common classs for validations */
class ValidationCommons {
  /**
   * Compress value (remove whitespace characters)
   * @param value
   * @returns
   */
  static Compress(value) {
    return value.replace(/\s+/g, "");
  }
  /**
   * Validate HEX value
   * @param value
   * @returns
   */
  static ValidateHEX(value, length, validateCompressed = false) {
