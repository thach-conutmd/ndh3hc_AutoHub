      let xmlSecurityCases = xmlSecurityBom.SecurityCases[0].SecurityCase;
      if (xmlSecurityCases && xmlSecurityCases.length > 0) {
        xmlSecurityCases.forEach(securityCase => {
          let idx = this.sercurityCaseArray.findIndex(s => s.Name === securityCase.$?.Name);
          if (idx > -1 && this.sercurityCaseArray[idx]) {
            this.sercurityCaseArray[idx].Value = securityCase._ ? securityCase._ : "";
