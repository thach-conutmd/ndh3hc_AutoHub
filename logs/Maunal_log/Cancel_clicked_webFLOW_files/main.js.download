      styles: ["\n\n\n\n\n\n\n\n[_nghost-%COMP%] {\n  display: flex;\n  flex-direction: column;\n  height: 100vh;\n  overflow: hidden;\n}\n[_nghost-%COMP%]     .root-element li {\n  padding-left: 0 !important;\n  margin-bottom: 0 !important;\n  font-size: 12px !important;\n}\n\n\n\n\n\n\n[_nghost-%COMP%]     \n.root-element \n.tree-element \n.p-tree-container \n.p-treenode \n.p-treenode-children {\n  padding-left: 1.25rem !important;   \n\n}\n\n\n.root-element[_ngcontent-%COMP%] {\n  width: 100%;\n  height: 100%;\n  flex: 1 1 auto;\n  min-height: 0;\n  position: relative;\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n}\n\n\n\n\n\n\n\n\n.root-element[_ngcontent-%COMP%]   .header-logo[_ngcontent-%COMP%] {\n  width: 30px;\n  height: 30px;\n  object-fit: contain;\n  margin-right: 8px;\n  vertical-align: middle;\n}\n\n.root-element[_ngcontent-%COMP%]   .header-home[_ngcontent-%COMP%] {\n  display: inline-flex;\n  align-items: center;\n  font: inherit !important;\n  color: inherit;\n  text-decoration: none;\n}\n\n.root-element[_ngcontent-%COMP%]   .header-home[_ngcontent-%COMP%]:focus, \n.root-element[_ngcontent-%COMP%]   .o-minimal-header__logo[_ngcontent-%COMP%]:focus {\n  outline: none !important;\n  box-shadow: none !important;\n}\n\n.root-element[_ngcontent-%COMP%]   .header-home[_ngcontent-%COMP%]:focus-visible, \n.root-element[_ngcontent-%COMP%]   .o-minimal-header__logo[_ngcontent-%COMP%]:focus-visible {\n  outline: 2px solid #007bc0 !important;\n  outline-offset: 3px;\n}\n\n.root-element[_ngcontent-%COMP%]   .o-minimal-header__title[_ngcontent-%COMP%]{\n  margin-inline-start: 1rem;\n}\n\n.root-element[_ngcontent-%COMP%]   .o-minimal-header__top[_ngcontent-%COMP%]{\n  border-bottom: 6px solid #E8F2FF;\n}\n\n\n\n\n\n\n.root-element[_ngcontent-%COMP%]   .sidebar[_ngcontent-%COMP%] {\n  width: 280px;\n  min-width: 280px;\n  background: #ffffff;\n  border: 1px solid #E8F2FF;\n  transition: none;\n  display: flex;\n  flex-direction: column;\n  heig