      styles: ["/* DIALOG */\n\n.bom-generator-dialog .p-dialog-header {\n    border-bottom: 1px solid #e9ecef;\n    color: #495057 !important;\n    padding: 0.5rem 1rem !important;\n}\n\n.bom-generator-dialog .p-dialog-content {\n    padding: 0.5rem 1rem 1rem 1rem !important;\n}\n\n/* LAYOUT */\n\n.bom-container {\n    display: flex;\n    flex-direction: column;\n}\n\n.bom-version-section {\n    display: flex;\n    align-items: center;\n    gap: 20px;\n    margin-bottom: 10px;\n    margin-left: 10px;\n}\n\n.bom-section-label {\n    font-weight: 600;\n    color: #495057;\n    min-width: 100px;\n    font-family: verdana, Helvetica, sans-serif !important;\n}\n\n.div-bom-version-container {\n    display: flex;\n    align-items: center;\n    font-family: verdana, Helvetica, sans-serif !important;\n}\n\n.div-bom-version-container p-radiobutton {\n    margin-right: 40px;\n}\n\n.bom-main-header-label {\n    font-family: verdana, Helvetica, sans-serif !important;\n    color: #334155 !important;\n    font-size: 12px;\n    font-weight: 600;\n}\n\n.panel.panel-primary .panel-heading.bom-main-header {\n    background-color: #eeeeee !important;\n    background-image: none !important;\n    border : transparent;\n}\n\n/* MAIN PANEL */\n\n.div-bom-panel {\n    border: 1px solid #d8dde3 !important;\n    border-radius: 6px;\n    overflow: hidden;\n    margin-bottom: 0;\n}\n\n.div-bom-schema-body {\n    padding: 10px 15px;\n}\n\n/* INNER PANELS */\n\n.div-bom-type-header {\n    background: #fafafa;\n    border-bottom: 1px solid #e9ecef;\n    padding: 2px 6px;\n}\n\n.label-bom-type {\n    margin: 0;\n    font-size: 12px;\n    font-weight: 600;\n    color: #495057;\n}\n\n/* CHECKBOX AREA */\n\n.div-bom-schema-type {\n    padding: 8px 16px;\n    max-height: 400px;\n    overflow-y: auto;\n    display: grid;\n    row-gap: 8px;\n}\n\n.bom-checkbox-item {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n}\n\n.bom-checkbox-label {\n    font-family: verdana, Helvetica, sans-serif !important;\n    margin: 0;\n    font-weight: normal;\n    color: #495057;\n    position: relative;\n    top: -1.5px;  \n}\n\n/* FOOTER */\n\n.bom-footer {\n    display: flex;\n    justify-content: flex-end;\n    gap: 10px;\n    padding-top: 10px;\n}\n\n/* BUTTONS */\n\n.bom-footer-btn.p-button {\n    transition: all 0.2s ease-in-out;\n    min-height: 30px !important;\n    padding: 2px 6px !important;\n    font-size: 12px !important;\n    line-height: 1;\n}\n\n.bom-footer-btn.p-button:hover {\n    background-color: #e0e0e0 !important;\n    border-color: #bdbdbd !important;\n    color: #000 !important;\n}\n\n.bom-footer-btn.p-button:hover .p-button-label,\n.bom-footer-btn.p-button:hover .p-button-icon {\n    color: #000 !important;\n}\n\n.bom-footer-btn.p-button .p-button-label {\n    font-family: verdana, Helvetica, sans-serif !important;\n    font-size: 12px !important;\n    position: relative;\n    top: -1px;  \n}\n\n.bom-footer-btn.p-button .p-button-icon {\n    font-size: 12px !important;\n    margin-right: 0 !important;\n}\n\n/* GRID */\n\n.metadata-grid,\n.properties-grid {\n    grid-template-columns: repeat(4, minmax(80px, 1fr));\n    column-gap: 10px;\n}\n\n/* PANELS */\n\n.panel-top {\n    margin-bottom: 10px;\n    background-color: #fff;\n    border: 1px solid transparent;\n    border-radius: 4px;\n    box-shadow: 0 1px 1px rgba(0,0,0,.05);\n}\n\n.panel-bottom {\n    margin-bottom: 0;\n    background-color: #fff;\n    border: 1px solid transparent;\n    border-radius: 4px;\n    box-shadow: 0 1px 1px rgba(0,0,0,.05);\n}\n\n.bom-generator-dialog .p-radiobutton .p-radiobutton-box {\n    width: 18px;\n    height: 18px;\n}\n\n.bom-generator-dialog .p-radiobutton .p-radiobutton-box .p-radiobutton-icon {\n    width: 8px;\n    height: 8px;\n}\n\n/*# sourceMappingURL=data:application/json;charset=utf-8;base64, */"],
