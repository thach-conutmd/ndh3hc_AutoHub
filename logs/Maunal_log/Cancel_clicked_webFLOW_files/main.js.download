    this.BC_Test = 3;
    this.BC_Integration = 4;
    this.BC_Release = 5;
    this.BC_Configuration = 8;
    /// <summary>
    /// This is the export string of debug DE build
    /// </summary>
    this.BC_EXPORT_DEV_DE = "Dev-DE";
    /// <summary>
    /// This is the export string of test build
    /// </summary>
    this.BC_EXPORT_TEST = "Test";
    /// <summary>
    /// This is the export string of integration build
    /// </summary>
    this.BC_EXPORT_INTEGRATION = "Integration";
    /// <summary>
    /// This is the export string of configuration system build
    /// </summary>
    this.BC_EXPORT_CONFIGURATION = "Configuration";
    /// <summary>
    /// This is the export string of production build
    /// </summary>
    this.BC_EXPORT_PRODUCTION = "Production";
    this.vsBuildConfig = vsBuildConfig;
  }
}

