  contextMenuClick(event, item) {
    event.preventDefault();
    if (event.target["innerText"] == "Open search") {
      this.openSearch(null, item);
    }
    if (event.target["innerText"] == "Open search in left frame at the bottom") {
      this.openSearchInLeftFrame(item);
