             // save to memory stream
        MemoryStream ms = new MemoryStream();
        doc.Save(ms);
             // now let's convert to Content
        ms.Seek(0, SeekOrigin.Begin);
        this.Contents = new byte[ms.Length];
        ms.Read(this.Contents, 0, (int)ms.Length);
             // and now set proper MIME
        this.MIME = "application/xml";
        */
        throw new Error("Constructing PlusFile from XDocument not implemented.");
      }
    }
  }
  /**
   * Saves plus file to stream
   * @param stream Stream to save to
   */
  SaveToStream(stream) {
    stream.Write(this.Contents, 0, this.Contents.length); // ##### will need rework in case this is used
  }
  // #region Bridging
  /**
   * Generates transport from the business object
   * @param manager Associated manager of the bridging
   * @returns Instance to the transport object
   */
  GenerateTransport(manager) {
    const result = new src_app_MMC_Swift_WSData_Files_FileTransport__WEBPACK_IMPORTED_MODULE_0__.FileTransport();
    result.FileName = this.FileName;
