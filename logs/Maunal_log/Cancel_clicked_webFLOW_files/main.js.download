          SecurityCase: []
        },
        ConnectivityFeatures: {
          ConnectivityFeature: []
        },
        UseCases: {
          UseCase: []
        }
      }
    };
    this.securityThirdPartyVersionData.forEach(data => {
      if (data.Value) {
        xmlObj.SecurityBom.SecurityRelevantThirdPartyVersions.SecurityRelevantThirdPartyVersion.push({
          Value: data.Value,
          Vendor: data.Vendor,
          ProductName: data.ProductName,
          Description: data.Description,
          VendorPackageIdentification: data.VendorPackageIdentification,
          VendorPackageVersion: data.VendorPackageVersion //todo: remove
        });
      }
    });
    if (this.pverValue) {
      xmlObj.SecurityBom.PVER = this.pverValue;
    }
    xmlObj.SecurityBom.CSecM = this.cSecMValue;
    xmlObj.SecurityBom.PRSecM = this.cSecMValue;
    this.securityRelevantVersionArray.forEach(securityRelevantVersion => {
      if (securityRelevantVersion.Value) {
        xmlObj.SecurityBom.SecurityRelevantVersions.SecurityRelevantVersion.push({
          _: securityRelevantVersion.Value
        });
      }
    });
    this.sercurityCaseArray.forEach(securityCase => {
      xmlObj.SecurityBom.SecurityCases.SecurityCase.push({
        $: {
          Name: securityCase.Name
        },
        _: securityCase.Value
      });
    });
    this.connectivityFeatureArray.forEach(connectivityFeature => {
      if (connectivityFeature.Name == "Others" && connectivityFeature.Value && connectivityFeature.AdditionalValue) {
        xmlObj.SecurityBom.ConnectivityFeatures.ConnectivityFeature.push({
          $: {
            Name: connectivityFeature.Name
          },
          _: connectivityFeature.Value,
          AdditionalValue: connectivityFeature.AdditionalValue
        });
      } else {
        xmlObj.SecurityBom.ConnectivityFeatures.ConnectivityFeature.push({
          $: {
            Name: connectivityFeature.Name
          },
          _: connectivityFeature.Value
        });
      }
    });
