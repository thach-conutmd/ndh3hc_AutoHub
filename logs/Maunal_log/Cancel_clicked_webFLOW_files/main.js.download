/** Class handling animations happening in the ComboBox */
class LODMultiSelectComboBoxAnimation {
  /**
   * Initializes a new instance of the <see cref="Animations"/> class.
   * @param lcb Parent combobox
   */
  constructor(lcb) {
    this.parent = lcb;
  }
  /** This is the degree how the invalid border should be displayed */
  get InvalidBorderDisplayDegree() {
    return this._InvalidBorderDisplayDegree;
  }
  set InvalidBorderDisplayDegree(value) {
    this._InvalidBorderDisplayDegree = value;
  }
  /** This is the color of the invalid border, which should be set */
  get InvalidBorderColor() {
    return this._InvalidBorderColorProperty;
  }
  set InvalidBorderColor(value) {
    this._InvalidBorderColorProperty = value;
  }
}

