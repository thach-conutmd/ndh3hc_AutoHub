          ...event.value
        },
        SecurityGroup: []
      };
      if (getSecBOMSecurityGroup.SecurityGroups && getSecBOMSecurityGroup.SecurityGroups.length > 0) {
        if (getSecBOMSecurityGroup.CategoryExtendMenu && getSecBOMSecurityGroup.CategoryExtendMenu.length > 0) {
          this.categoryExtendMenu = getSecBOMSecurityGroup.CategoryExtendMenu.map(s => ({
            ID: s.ID,
            Value: s.Name,
            IsShowWhat: s.IsShowWhat
          }));
        }
        getSecBOMSecurityGroup.SecurityGroups.forEach(securityBomGroup => {
          //const securityBomGroup: SecurityBomGroup = TransportBridging.CurrentTransportBridgesManager.GenerateBusinessObject<SecurityBomGroup>(securityBomGroupTransport);
          const curSecurityGroup = {
            ID: securityBomGroup.ID,
            Name: securityBomGroup.Name,
            Features: []
          };
          if (securityBomGroup.Features && securityBomGroup.Features.length > 0) {
            securityBomGroup.Features.forEach(feature => {
              const curFeature = {
                ID: feature.ID,
                Name: feature.Name,
                PreSelectedActivationStatus: feature.PreSelectedActivationStatus ? {
                  ID: feature.PreSelectedActivationStatus.ID,
                  Value: feature.PreSelectedActivationStatus.Value
                } : null,
                ActivationStatus: feature.ActivationStatus ? {
                  ID: feature.ActivationStatus.ID,
                  Value: feature.ActivationStatus.Value
                } : null,
                ActivationStatusDataSource: feature.ActivationStatusDataSource.map(s => ({
                  ID: s.ID,
                  Value: s.Value
                })),
                CryptoCategories: [],
                Description: feature.Description
              };
              if (feature.CryptoCategories && feature.CryptoCategories.length > 0) {
                let isExistExtendMenu = false;
                feature.CryptoCategories.forEach(category => {
                  const curCategory = {
                    ID: category.ID,
                    Name: category.Name || "",
                    PreSelectedValue: category.PreSelectedValue ? {
                      ID: category.PreSelectedValue.ID,
                      Value: category.PreSelectedValue.Value
                    } : null,
                    CryptoValue: category.CryptoValue ? {
                      ID: category.CryptoValue.ID,
                      Value: category.CryptoValue.Value
                    } : null,
                    ElementType: category.ElementType,
                    IsShowHideCryptoValue: category.IsDisplayShowHideCrypto,
                    CryptoDataSource: category.CryptoDataSource ? category.CryptoDataSource.map(s => ({
                      ID: s.ID,
                      Value: s.Value
                    })) : []
                  };
                  if (category.ElementType == this.CryptoCategoryElementType.ExtendMenu) {
                    isExistExtendMenu = true;
                  }
                  if (category.ElementType == this.CryptoCategoryElementType.ExchangeMenu) {
                    curCategory.IsShowCryptoValue = false;
                  }
                  if (category.ElementType != this.CryptoCategoryElementType.ExtendMenu && category.NumberOfInput > 1) {
                    for (let index = 2; index <= category.NumberOfInput; index++) {
                      const cloneCategory = JSON.parse(JSON.stringify(curCategory));
                      curFeature.CryptoCategories.push(cloneCategory);
                    }
                  }
                  curFeature.CryptoCategories.push(curCategory);
                });
                if (isExistExtendMenu) {
                  const extendMenuDataSource = curFeature.CryptoCategories.filter(s => s.ElementType == this.CryptoCategoryElementType.ExtendMenu);
                  const defaultSelectedCategories = [];
                  extendMenuDataSource.forEach(cate => {
                    if (cate.CryptoValue) {
                      const defaultCategoryExtendMenu = this.categoryExtendMenu.find(s => s.ID == sercurityBCId);
                      defaultSelectedCategories.push({
                        ...cate,
                        SelectedCategoryItem: {
                          ID: cate.ID,
                          Value: cate.Name
                        },
                        CategoryExtendMenu: {
                          ...defaultCategoryExtendMenu
                        }
                      });
                    }
                  });
                  curFeature.ExtendMenuItems = {
                    SelectedCategories: defaultSelectedCategories,
                    CryptoCategoryDataSource: extendMenuDataSource.map(s => ({
                      ID: s.ID,
                      Value: s.Name
