/** Business object representing the information of a single PIDC attribute */
class PIDCAttribute {
  get ValuesString() {
    let sb = "";
    for (let o of this.Values) {
      if (o != null) sb = sb.concat(o.toString()).concat("; "); // ##### o.toString needs to be verified, whether it's correctly implemented or whether we need something else
    }
    if (sb.length > 2) sb = sb.substr(0, sb.length - 2);
    return sb;
  }
  constructor(name, values) {
    this.Name = name || '';
    this.Values = values || undefined;
  }
}

