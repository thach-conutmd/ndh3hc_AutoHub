          if (this.FileListItemViewModel.FileName) fileinfo.FileName = this.FileListItemViewModel.FileName;
          fileinfo.WFFileEndings = this.FileListItemViewModel.FileExtension;
        }
        fileinfo.DSTVersionNumber = this.SelectedItem.VersionNumber;
        fileinfo.DSTElementName = this.SelectedItem.Name;
        fileinfo.DSTElementVariant = this.SelectedItem.Variant;
        fileinfo.DSTElementRevision = this.SelectedItem.Revision;
