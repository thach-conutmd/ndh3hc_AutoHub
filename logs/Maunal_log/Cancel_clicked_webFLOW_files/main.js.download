          void cdmVersion_SearchContentCompleted(object sender, SearchContentCompletedEventArgs e)
          {
              try
              {
                  CDMVersionClient.SearchContentCompleted -=
                              new EventHandler<SearchContentCompletedEventArgs>(cdmVersion_SearchContentCompleted);
                  CDMFileInfoBuilder fileinfo = (CDMFileInfoBuilder)e.UserState;
  
