            return res;
          }
        }
      }
    }
    if (this.BsData.BsItems.IsInvalidDueToSpecificPeerValidation()) {
      res.errorOnSearch = 'Illegal Search: Criteria are considered to cause bad performance because they are too unspecific.';
    }
    return res;
