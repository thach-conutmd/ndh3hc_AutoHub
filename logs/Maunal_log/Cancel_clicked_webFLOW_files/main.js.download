/* harmony export */   SaveFileDownloadFromPDT: () => (/* binding */ SaveFileDownloadFromPDT)
/* harmony export */ });
function SaveFileDownloadFromPDT(blob, filename) {
  const url = window.URL.createObjectURL(blob);
  const anchorEle = document.createElement('a');
  anchorEle.href = url;
  anchorEle.download = filename;
  document.body.appendChild(anchorEle);
  anchorEle.click();
  document.body.removeChild(anchorEle);
  window.URL.revokeObjectURL(url);
}

