/* (won't really work)

export type IChildObjectVersions = // implements Map<string, ObjectVersion>, MapConstructor, Iterable<ObjectVersion>
    {
        [key: string]: ObjectVersion;
        [key: number]: ObjectVersion;
    }
    &
    {
        length: number;
        _length: number;
        add(ov: ObjectVersion): boolean;
    }

*/
class ChildVersions {
  get length() {
    return this._length;
  }
  constructor(list) {
    this.keys = []; // ordered array of keys so we can get ObjectVersion #n
    this.map = {};
    this._length = 0;
    if (list) {
      for (let ov of list) {
        this.insert(ov);
      }
    }
  }
  [Symbol.iterator]() {
    let ix = 0;
    const items = this.map;
    const keys = this.keys;
    return {
      next() {
        if (ix < keys.length) {
          return {
            done: false,
            value: items[keys[ix++]]
          };
        } else {
          return {
            done: true,
            value: null
          };
        }
      }
