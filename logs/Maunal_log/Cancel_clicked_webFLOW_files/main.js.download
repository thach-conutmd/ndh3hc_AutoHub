      styles: ["@media all and (-ms-high-contrast:none) {\n    *[_ngcontent-%COMP%]::-ms-backdrop,   .ui-table table {\n        table-layout: auto;\n    }\n}\n\ntable[_ngcontent-%COMP%] {\n    width: 100%;\n    table-layout: auto;\n}\n\n[_nghost-%COMP%]     .file-list-table table {\n    width: 100% !important;\n    table-layout: fixed !important;\n}\n\ntr[_ngcontent-%COMP%], td[_ngcontent-%COMP%] {\n    margin: 0% !important;\n    \n\n}\n\n\n\n\n\n\n\n\n\n\n\n\n\n  body .uploadButton {\n    background-color: transparent;\n    color: black;\n    font-weight: bolder;\n    font-size: 19px !important;\n}\n\n  body .ui-table .ui-table-tbody>tr.ui-state-highlight {\n    background-color: rgb(186, 221, 233) !important;\n    color: black;\n}\n\n  body .ui-table .ui-table-tbody>tr:nth-child(even).ui-state-highlight {\n    background-color: rgb(186, 221, 233) !important;\n    color: black;\n}\n\n\n\n\n\n\n\n\n  body .ui-button:enabled:hover {\n    background-color: rgb(206, 225, 240);\n    color: black;\n    border-color: grey;\n}\n\n.error[_ngcontent-%COMP%] {\n    background-color: rgb(255, 176, 176) !important;\n}\n\n.warning[_ngcontent-%COMP%] {\n    background-color: rgb(255, 205, 136) !important;\n}\n\n.error-border[_ngcontent-%COMP%] {\n    border: 1px solid rgb(255, 176, 176) !important;\n}\n\n.warning-border[_ngcontent-%COMP%] {\n    border: 1px solid rgb(255, 205, 136);\n}\n\n[_nghost-%COMP%]     body .ui-button {\n    border: 1px solid rgb(103, 122, 138) !important;\n}\n\n[_nghost-%COMP%]     .ui-button-icon-left {\n    display: none !important;\n}\n\n[_nghost-%COMP%]     .ui-button-text.ui-clickable {\n    padding: 0px 4px 1px 4px !important;\n}\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n  .ui-table .ui-button {\n    border: 1px solid rgb(103, 122, 138) !important;\n}\n\n[_nghost-%COMP%]     .uploadButton .ui-button {\n    background-color: rgba(241, 243, 244, 1) !important;\n    color: black\n}\n\n  .ui-selectable-row {\n    background-color: #f9f9f9 !important;\n}\n\n.c