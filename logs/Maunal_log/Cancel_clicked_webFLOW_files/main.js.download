  /**
   * Retrieves mandatory parameter by name
   * // typeparam T Type of the parameter value  // As discussed with Martin, generic 'T' is not required
   * @param name Name of the parameter
   * @param context Context under which the parameter should be retrieved
   * @returns Parameter value
   */
  // As discussed with Martin, generic 'T' is not required and has been removed (no benefit in the absence of .NET's type checking system)
  GetMandatoryParameterValueByName(name, context) {
    const result = this.namedParameters.get(name);
    if (!result) {
      throw new Error("Missing required parameter: " + name);
    }
    return result.Value.GetValue(context.DataContext);
  }
  /**
   * Retrieves optional parameter value by name (optional only in case it doesn't exist; in case it exists, but fails to convert to desired type, exception is thrown - performance reasons)
   * // typeparam T Type to be retrieved  // As discussed with Martin, generic 'T' is not required
   * @param name Name of the parameter
   * @param context Resolution context
   * @param defaultValue Default value, which should be returned in case the parameter is not defined
   * @returns Value of the parameter or defaultValue if doesn't exist
   */
  // As discussed with Martin, generic 'T' is not required and has been removed (no benefit in the absence of .NET's type checking system)
  GetOptionalParameterValueByName(name, context, defaultValue) {
    const result = this.namedParameters.get(name);
    if (!result) {
      return defaultValue;
    } else {
      return result.Value.GetValue(context.DataContext);
    }
  }
  /**
   * Retrieves mandatory parameter, which is searched by following pattern:
   * 1. It is checked, whether there is parameter with specified name defined - if there is, its value is resolved and returned
   * 2. It is checked, whether there is parameter with no name defined at index 0 index - if there is, its value is resolved and returned
   * 3. If both above mentioned points fail to yield any result, exception is thrown
   * // typeparam T Type of the parameter to be returned  // As discussed with Martin, generic 'T' is not required
   * @param name Name of the parameter to be searched for
   * @param context Context under which the parameter should be resolved
   * @returns Parameter value
   */
  // As discussed with Martin, generic 'T' is not required and has been removed (no benefit in the absence of .NET's type checking system)
  GetMandatoryParameterValueByNameOrFirst(name, context) {
    let result;
    // try to do search as described in point 1
    result = this.namedParameters.get(name); //[name];
    if (!result) {
      // nope, no luck - try to search by point 2
      if (this.parameters.length <= 0) {
        throw new Error("Parameter with name '" + name + "' or index 0 is required");
      }
      result = this.parameters[0];
      if (result.HasName) {
        throw new Error("Parameter with name '" + name + "' or index 0 (without name) is required");
      }
    }
    return result.Value.GetValue(context.DataContext);
  }
}

