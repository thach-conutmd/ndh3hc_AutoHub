/// <summary>
/// Check if substring value Equals to comparable value // PDFLOW-873 -  Creation of handling Substrings in the Markup module //Release :12.x.x
/// </summary>
let SubstringHandler = class SubstringHandler {
  /// <summary>
  /// Resolves the markup in specified resolution context
  /// </summary>
  /// <param name="context">Context, which provides access to the parameters and data context</param>
  /// <returns>
  /// Object, which the markup was resolved to. It might or might not correspond with desired type. Markup conversion takes place in case types differ.
  /// </returns>
  Resolve(context) {
    let value = context.Descriptor.GetMandatoryParameterValueByNameOrFirst("Value", context);
    let startindex = context.Descriptor.GetMandatoryParameterValueByNameOrFirst("startindex", context);
    let length = context.Descriptor.GetMandatoryParameterValueByNameOrFirst("length", context);
    let lengthFromEnd = context.Descriptor.GetOptionalParameterValueByName("LengthFromEnd", context, 0);
    //   IComparable compareToValue = context.Descriptor.GetMandatoryParameterValueByName<IComparable>("ValueToCompare", context); --hided for implement geneic way by Rangaraj
    try {
      if (lengthFromEnd > 0) {
        if (value.toString().length < lengthFromEnd) {
          let intVal = Number(value.toString());
          if (intVal <= 0) {
            return "0";
          }
          return intVal.toString();
        } else {
          const regExp = new RegExp(`\\d{${lengthFromEnd}}$`, "g");
          let intVal = Number(value.toString().match(regExp));
          if (intVal <= 0) {
            return "0";
          }
          //return Regex.Match(value.ToString(), "(.{" + lengthFromEnd + @"})\s*$").ToString();
          return intVal.toString();
        }
      } else {
        if (value.toString().trim() == "") return "";else {
          if (value.toString().length < length) return value.toString();else return value.toString().substr(startindex, length);
        }
      }
    } catch (err) {
      return false;
    }
  }
};
