/**
 * This represents the default expression bridge for the expression
 * @typeparam B Type of the business object
 * @typeparam T Type of the transport
 */
class SearchExpressionDefaultExpressionBridge {
  constructor(ctorBO) {
    this.ctorBO = ctorBO;
  }
  /**
   * Generates the transport
   * @param manager Manager, which is used for TransportObject generation
   * @param businessObject Business object to generate from
   * @returns The transport object
   */
  GenerateTransportObject(manager, businessObject) {
    const bo = businessObject;
    if (bo instanceof this.ctorBO) {
      bo['InitializeTransport'](manager); // call protected method from bridge
      const transport = bo.Data;
      return transport;
    }
    throw new Error("Unable to generate Transport object for the search expression.");
  }
  /**
   * Generates business object from transport object
   * @param manager Manager, which is currently used for generation
   * @param transportObject Transport object, which should be transformed to the business object
   * @returns Generated business object
   */
  GenerateBusinessObject(manager, transportObject) {
    const to = transportObject;
    if (to) {
      // original type check can't be properly ported for transport in TypeScript, so we skipped it
      const bo = new this.ctorBO();
      bo['AcceptData'](manager, to); // call protected method from bridge
      bo['_Data'] = to; // access private member from bridge
      return bo;
    }
    throw new Error("Unable to generate business object for the search expression.");
  }
}

