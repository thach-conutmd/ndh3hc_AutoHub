n}\n\n.groupbox-title[_ngcontent-%COMP%] {\n    flex: 1;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n}\n\n.elegant-groupbox-body[_ngcontent-%COMP%] {\n    padding: 12px;\n    background: #fff;\n    font-size: 12px;\n}\n\n.elegant-groupbox-header[_ngcontent-%COMP%]   .pi[_ngcontent-%COMP%] {\n    font-size: 12px;\n    color: #64748b;\n}\n\n.header-right[_ngcontent-%COMP%] {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    flex-shrink: 0;\n}\n\n.info-icon[_ngcontent-%COMP%] {\n    font-size: 14px !important;\n    color: #64748b !important;\n    cursor: pointer;\n    display: inline-flex !important;\n    visibility: visible !important;\n    opacity: 1 !important;\n}\n\n.modified-badge[_ngcontent-%COMP%] {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 4px;\n    background: #ffd54f;\n    color: #000;\n    padding: 4px 6px;\n    margin-left: 8px;\n    border-radius: 4px;\n    font-size: 10px;\n    line-height: 1;\n}\n\n.modified-badge[_ngcontent-%COMP%]   .pi[_ngcontent-%COMP%] {\n    font-size: 10px !important;\n}\n\n.remove-btn[_ngcontent-%COMP%] {\n    width: 28px;\n    height: 28px;\n    border: none;\n    border-radius: 8px;\n    background: transparent;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    cursor: pointer;\n    float: right;\n}\n.remove-btn[_ngcontent-%COMP%]   i[_ngcontent-%COMP%] {\n    font-size: 16px;\n    color: #7b8794;\n}\n.remove-btn[_ngcontent-%COMP%]:hover {\n    background: #ffeaea;\n}\n.remove-btn[_ngcontent-%COMP%]:hover   i[_ngcontent-%COMP%] {\n    color: #d32f2f;\n}\n.remove-btn[_ngcontent-%COMP%]   .pi.pi-trash[_ngcontent-%COMP%] {\n    font-size: 18px;\n}\n\n.elegant-groupbox-body[_ngcontent-%COMP%]    > .form-group[_ngcontent-%COMP%] {\n    padding-bottom: 5px;\n    border-bottom: 1px solid #edf1f5;\n    margin-bottom: 10px;\n}\n\n[_nghost-%COMP%]     .add-On-button {\n    height: 32px;\n    font-size: 12px;\n    border-radius: 8px;\n}\n\n.checkbox-group-layout[_ngcontent-%COMP%] {\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n    margin-top: 4px;\n}\n\n.align-checkbox-item[_ngcontent-%COMP%] {\n    display: inline-flex !important;\n    align-items: center !important;\n    width: 100%;\n}\n\n.checkbox-label[_ngcontent-%COMP%] {\n    font-weight: normal !important;\n    margin-left: 8px !important;\n    margin-bottom: 0 !important;\n    font-size: 11px;\n    line-height: 1.2;\n    cursor: pointer;\n}\n\n[_nghost-%COMP%]     .align-checkbox-item p-checkbox {\n    display: inline-flex;\n    align-items: center;\n}\n\n[_nghost-%COMP%]     .align-checkbox-item .p-checkbox {\n    display: flex;\n    align-items: center;\n}\n\n.sub-field-row[_ngcontent-%COMP%] {\n    margin-left: 24px; \n    margin-top: 4px;\n}\n\n\n\n\n[_nghost-%COMP%]     .p-dropdown.activation-status-dropdown {\n    width: 240px !important;     \n\n    min-width: unset !important;  \n\n}\n/*# sourceMappingURL=data:application/json;charset=utf-8;base64, */"]
