  get completedCount() {
    if (!this.progressStatus) {
      return 0;
    }
    return this.progressStatus.filter(job => {
      const steps = this.getJobSteps(job);
      return steps.every(item => {
        const status = item.step?.status;
        return status === 'success' || status === 'sucess' || status === 'warning' || status === 'error' && this.isOptionalStep(item.name);
      });
    }).length;
  }
  get pendingCount() {
    if (!this.progressStatus) {
      return 0;
    }
    return this.progressStatus.filter(job => {
      const steps = this.getJobSteps(job);
      return !steps.every(item => {
        const status = item.step?.status;
        return status === 'success' || status === 'sucess' || status === 'warning' || status === 'error' && this.isOptionalStep(item.name);
      });
    }).length;
  }
  get progressPercentage() {
    if (!this.progressStatus || this.progressStatus.length === 0) {
      return 0;
    }
    let completedSteps = 0;
    let totalSteps = 0;
    this.progressStatus.forEach(job => {
      const steps = this.getJobSteps(job);
      totalSteps += steps.length;
      steps.forEach(item => {
        const status = item.step?.status;
        const isCompleted = status === 'success' || status === 'sucess' || status === 'warning' || status === 'error' && this.isOptionalStep(item.name);
        if (isCompleted) {
          completedSteps++;
        }
      });
    });
    return Math.round(completedSteps / totalSteps * 100);
  }
