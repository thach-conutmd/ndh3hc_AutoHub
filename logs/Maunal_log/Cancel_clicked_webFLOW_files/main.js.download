/**
 * List of entities
 * Limitations of each entity's @see Fields ' entries created from Transport layer:
 * @see Flags: Flags will be cleared,
 * @see Flags: Validity will not carry the record's real information.
 * See also @see EntityListBridge{TEntity, TTransport, B}
 * @typeparam TEntity Type of entity in list
 * @typeparam TTransport The type of the transport
 */
class EntityList {
  /** Initializes a new instance of the @see EntityList{TEntity, TTransport} class. */
  constructor() {
    /** The meta entity */
    this.metaEntity = undefined; // = default(TEntity);
    /** The list of non meta entities */
    this.entities = new Array();
  }
  /** Gets the non meta entities. */
  get Entities() {
    return this.entities;
  }
  /** Gets the meta entity. */
  get MetaEntity() {
    return this.metaEntity;
  }
