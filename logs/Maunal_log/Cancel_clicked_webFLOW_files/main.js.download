    instancememberrequest.CustomerGroup = CustomerGroup;
    instancememberrequest.Workingmode = Workingmode;
    instances = this.instancesTransport.filter(it => {
      let isPresent = false;
      this.selectedInstanceList.map(sil => {
        if (sil.InstanceId === it.InstanceId) {
          isPresent = true;
        }
      });
      if (isPresent) return it;
    });
    instancememberrequest.instancesTransport = instances;
    this.adminService.AddInstanceMemberToJob(instancememberrequest).toPromise().then(res => {
      this.TxtQueryWindow = res;
    });
  }
