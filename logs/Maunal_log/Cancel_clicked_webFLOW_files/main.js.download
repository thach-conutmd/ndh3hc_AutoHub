   */
  constructor(fileName, contents, mime, xdoc) {
    //TODO -will update later ...arg
    if (fileName === undefined || fileName === null) {
      // empty constructor, do nothing: Initializes a new instance of the @see PlusFile class.
    } else {
      if (contents) {
        this._FileName = fileName;
        this._Contents = contents.constructor === Uint8Array ? contents : new Uint8Array(contents);
