        }
      }
      if (files.length == 0) {
        return true;
      }
      if (files.length > 0) {
        let fileinfo = files[0];
        let filesize = fileinfo.payload.contentLength;
        if (filesize == 0) {
          return true;
        }
      }
    }
    return false;
  }
};
