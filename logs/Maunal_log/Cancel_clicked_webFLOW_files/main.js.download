  /*
   * Initializes a new instance of the @see Parameter class.
   * @param name="leadToken">The lead token.</param>
   * @param name="value">The value of the parameter</param>
   */
  // public Parameter(Token leadToken, ParameterValue value) { ... }
  /**
   * Initializes a new instance of the <see cref="Parameter"/> class.
   * @param name="leadToken">The lead token.</param>
   * @param name="tokenName">Name of the token.</param>
   * @param name="value">The value.</param>
   * @exception ParserInternalException Parameter name can't contain '@'
   */
  constructor(leadToken, tokenName, value) {
    this._LeadToken = leadToken;
    // extract the name (if the token name is provided)
    if (!tokenName) {
      this._Name = "";
    } else {
      // check whether the parameter name is in proper format
      if (tokenName.HasRegion) throw new _Parser_Exceptions_ParserInternalException__WEBPACK_IMPORTED_MODULE_1__.ParserInternalException("Parameter name can't contain @", tokenName);
      this._Domain = tokenName.TextDomain;
      this._Name = tokenName.TextName;
      this._FullName = tokenName.Text;
    }
    // and store parameter value (it will be used later to resolve real value)
    this._Value = value;
  }
}

