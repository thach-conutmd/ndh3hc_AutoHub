/**
* Author  : Thach Thanh Thien
* Remarks : propertyInfo (from line 39 to 4 may need to be reworked)
* Date    : 03.09.2019
* Reviewer: Frank
* Reviewed: 22.10.2019
* * */
/** Base for FieldValue (common path resolving) */
class FieldValueBase {
  /**
   * Gets the value from the field (localized by path)
   * @param fieldCollection The field collection.
   * @param path The path.
   * @returns Value or null if not found
   */
  GetFieldValue(fieldCollection, path) {
    // Parse path (period (.) is path elements separator)
    const matches = path.match(/[^\.]+/g);
    if (matches.length >= 1) {
      // Get field if exists
      const field = fieldCollection.FieldCollection.GetFieldByNameIfExists(matches[0]);
      if (!field) return null;
      // get field value
      let value = field.Value;
      // try to resolve path
      for (let i = 1; i < matches.length; i++) {
        if (value === null || value === undefined) return null;
        // ported the part using C#/.NET Reflection differently, since we can directly access the values of any object via string:
        let propertyValue = null;
        if (typeof value === 'object') propertyValue = value[matches[i]]; // simply access value via name
        if (propertyValue === null || propertyValue === undefined) return null;
        // Replace value by found propertyValue
        value = propertyValue;
      }
      return value;
    }
    return null;
  }
}

