        const xmlFeature = {
          Value: feature.Name,
          ActivationStatus: {
            _: feature.ActivationStatus.Value
          },
          CryptoCategories: {
            CryptoCategory: []
          }
        };
        var isCheckBoxFeature = true;
        var isFeatureEnabled = true;
        if (feature.ActivationStatus.Value == "Enabled") {
          var isAllCategoryValidated = false;
          if (!feature.CryptoCategories || feature.CryptoCategories.length <= 0) {
            isCheckBoxFeature = false;
          }
          feature.CryptoCategories.forEach(category => {
            const xmlCategory = {
              Value: category.Name || "",
              //ElementType: category.ElementType,
              CryptoValues: {
                CryptoValue: []
              }
            };
            if (category.ElementType == this.CryptoCategoryElementType.LabelMenu) {
              isCheckBoxFeature = false;
              return;
            }
            if (category.ElementType == this.CryptoCategoryElementType.ExtendMenu) {
              isCheckBoxFeature = false;
              if (feature.ExtendMenuItems?.SelectedCategories?.length <= 0) return;
              const existCategory = feature.ExtendMenuItems.SelectedCategories.find(s => s.SelectedCategoryItem?.ID == category.ID);
              if (!existCategory) return;
            }
            if (category.IsShowHideCryptoValue) {
              xmlCategory["IsShowCryptoValue"] = category.IsShowCryptoValue ? category.IsShowCryptoValue : false;
            }
            if (!category.IsShowHideCryptoValue || category.IsShowCryptoValue) {
              switch (category.ElementType) {
                case this.CryptoCategoryElementType.DropDownMenu:
                  {
                    isCheckBoxFeature = false;
                    if (category.CryptoValue) {
                      const cryptoValue = category.CryptoValue;
                      xmlCategory.CryptoValues.CryptoValue.push({
                        _: cryptoValue.Value
