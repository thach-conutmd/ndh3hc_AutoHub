/* harmony export */ });
/*
* Reviewer: Frank
* Reviewed: 07.08.2020
* Remarks : TriggerDataFill is an unclear additional member and was never explained/commented
* * */
/** Business object representing the information of PIDC field */
class PIDCValue {
  constructor(pidcID) {
    this.pidcElements = {};
    this.PIDC_ID = pidcID;
  }
  /** This is the count of errors encountered during PIDC import */
  get PIDC_ImportErrors() {
    return this.InternalImportErrors;
  }
  /** This is the collection of PIDC elements to import for APPLIED_FILE... selection */
  get PIDCElements() {
    if (!this.pidcElements) this.pidcElements = {};
    const result = new Array();
    for (let key of Object.keys(this.pidcElements)) {
      result.push(this.pidcElements[key]);
    }
    return result;
  }
  /*private*/
  AddPIDCElementInternal(element) {
    if (!this.pidcElements) this.pidcElements = {};
    const key = element.toString();
    if (this.pidcElements[key] !== undefined) throw new Error('Element "' + key + '" already present.'); // added when porting as replacement for C#'s native error thrown on attempting to add a duplicate via Dictionary<string, PDT_PIDC_Element_vCDM>.Add(...)
    this.pidcElements[key] = element;
  }
  /** Indicates whether the value contains a valid classification */
  get ContainsValidClassification() {
    if (!this.PIDC_Attributes) return false;
    return this.PIDC_Attributes.ContainsValidClassification;
  }
}

