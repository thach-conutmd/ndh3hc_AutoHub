  //adds ValidationResultControl component to job view page dynamically
  addValidationComponent(Validationcomponent, viewContainerRef) {
    const factory = this.resolver.resolveComponentFactory(Validationcomponent);
    const componentref = factory.create(viewContainerRef.injector);
    const component = componentref.instance;
    try {
      viewContainerRef.remove(0); //removing and adding component to refresh the validation summary after Save operation
    } catch {} // it's should be ignored
    viewContainerRef.insert(componentref.hostView);
    return component;
  }
  addDynamicComponent(Childcomponent, comp, viewContainerRef) {
