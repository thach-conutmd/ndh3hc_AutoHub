    }, {
      target: 'secbom-xml',
      title: 'Upload SecBOM XML',
      description: 'Next, select the SecBOM XML file. Both uploaded files are required before submitting to CSI.'
    }, {
      target: 'modelYear',
      title: 'Enter Model Year',
      description: 'Enter the model year manually using four digits in YYYY format.'
