/* harmony export */ });
/**
 * This is the base for the transport bridge where Business Object supports ILoadsTransport
 * @param T Type of the transport object
 * @param B Type of the business object
 */
class TransportBridgeGeneric {
  constructor(boConstructor) {
    this.boConstructor = boConstructor;
  }
  /**
   * Generates the transport
   * @param manager Manager, which is used for TransportObject generation
   * @param businessObject Business object to generate from
   * @returns The transport object
   */
  GenerateTransportObject(manager, businessObject) {
    // try to get generator interface
    const generator = businessObject;
    if (!generator) throw new Error("Business object '" + JSON.stringify(businessObject) + "' doesn't support bridging to desired transport.");
    // and generate result
    return generator.GenerateTransport(manager);
  }
  /**
   * Generates business object from transport object
   * @param manager Manager, which is currently used for generation
   * @param transportObject Transport object, which should be transformed to the business object
   * @returns Generated business object
   */
  GenerateBusinessObject(manager, transportObject) {
    // now generate business object - create it through parameterless constructor
    const result = new this.boConstructor();
    // convert transport object to strong type
    const tObj = transportObject;
    if (!tObj) throw new Error("Transport object can't be bridged");
    // and let business object load from transport
    result.LoadFromTransport(manager, tObj);
    // and return it
    return result;
  }
  /**
   * Creates the instance of the business object
   * @param dataContext Data context of the business object creation
   * @returns Business object
   */
  CreateBO(dataContext) {
    // now generate business object - create it through parameterless constructor
    const result = new this.boConstructor();
    return result;
  }
}

