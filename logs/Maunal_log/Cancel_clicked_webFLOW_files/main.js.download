/** Business object representing the PIDC information collection, synchronized with webFLOW information */
class PIDCAttributes {
  constructor() {
    this.pidcInfo = {};
    this.ClassificationIdValuePairs = {};
  }
  get Values() {
    return Object.values(this.pidcInfo || {});
  }
  GetIndexerByName(attrName) {
    const attr = this.pidcInfo[attrName];
    if (!attr) return null;
    if (attr.Values.length <= 0) return null;
    return attr;
  }
  EnsureAttributeValue(attrName, value) {
    let attr = this.pidcInfo[attrName];
    if (!attr) {
      attr = new _PIDCAttribute__WEBPACK_IMPORTED_MODULE_0__.PIDCAttribute(attrName, [value]);
      this.pidcInfo[attrName] = attr;
    } else {
      attr.Values.push(value);
    }
  }
  EnsureAttributeValues(attrName, values) {
    let attr;
    attr = this.pidcInfo[attrName];
    if (!attr) {
      const vals = [];
      for (let val of values) vals.push(val);
      attr = new _PIDCAttribute__WEBPACK_IMPORTED_MODULE_0__.PIDCAttribute(attrName, vals);
      this.pidcInfo[attrName] = attr;
    } else {
      for (let value of values) {
        attr.Values.push(value);
      }
    }
  }
  // replacement for:
  // public bool TryGetValue(string key, out PIDCAttribute attribute)
  GetValue(key) {
    return this.pidcInfo[key] || null;
  }
}

