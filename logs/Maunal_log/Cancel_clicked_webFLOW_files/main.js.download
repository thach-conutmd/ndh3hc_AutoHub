      target: 'modelDevice',
      title: 'Enter Model',
      description: 'Enter the device model manually.'
    }, {
      target: 'engineFamily',
      title: 'Enter Engine Family',
      description: 'Enter the engine family manually to complete the model details.'
    }, {
      target: 'generate-sbom',
      title: 'Generate SBOM File',
      description: 'Choose this action to generate and download the SBOM file to your computer.'
    }, {
      target: 'upload-csi',
      title: 'Upload to CSI Database',
      description: 'After generating the SBOM, choose this action to submit it and the selected source files to CSI.'
