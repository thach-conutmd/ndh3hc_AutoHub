  BtnAdd_Click() {
    if (this.selectedAvailableRouting) {
      let availableItems;
      availableItems = this.lstDefaultRoutings;
      if (availableItems) {
        if (availableItems.indexOf(this.selectedAvailableRouting) < 0) {
          availableItems.push(this.selectedAvailableRouting);
          this.lstDefaultRoutings = [...availableItems];
          this.leftbind = [...this.lstDefaultRoutings];
          for (let i = 0; i < this.rightbind.length; i++) {
            for (let j = 0; j < availableItems.length; j++) {
              if (availableItems[j] == this.rightbind[i]) {
                this.rightbind.splice(i, 1);
              }
            }
          }
          let RoutingPK = this.ReturndefPK(this.selectedAvailableRouting).toString();
          this.lstRoutings = [...this.rightbind];
          this.instancememberResult += "<p>Insert into CFG_GCA_DEFAULTROUTING (FK_CFG_GCA,FK_DEFAULTROUTING) values (" + this.FK_CFG_GCA + "," + RoutingPK + ");</p><br>";
          let head = "<p><b>Changes in the routing mappings are: </b></p>";
          let tail = "<p>Rollback;</p>";
          this.TxtQueryWindow = head + this.instancememberResult + tail;
        } else {
          // display message
          // cw.Content = "Routing " + ((DefaultRouting)lstRoutings.SelectedItem).DEFAULTROUTINGNAME + " already mapped with selected GCA";
          // cw.Title = "Mapping Result";
        }
      }
    }
  }
  ReturndefPK(defRouteName) {
    for (let deftcnt = 0; deftcnt < this.alldefroute.length; deftcnt++) {
      if (this.alldefroute[deftcnt].DEFAULTROUTINGNAME == defRouteName) {
        return this.alldefroute[deftcnt].PK_DEFAULTROUTING;
      } else if (defRouteName == "WebFlow_Internal_Testing") {
        return 6000;
      }
    }
    return -1;
  }
  BtnRemove_Click() {
    if (this.selectedDefaultRouting) {
      if (this.selectedDefaultRouting != 'WebFlow_Internal_Testing') {
        let availableItems;
        availableItems = this.lstRoutings;
        if (availableItems) {
          if (availableItems.indexOf(this.selectedDefaultRouting) < 0) {
            availableItems.push(this.selectedDefaultRouting);
            this.lstRoutings = [...availableItems];
          }
          const index = this.leftbind.indexOf(this.selectedDefaultRouting);
          if (index > -1) {
            this.leftbind.splice(index, 1);
          }
          let answer = this.ReturndefPK(this.selectedDefaultRouting).toString();
          this.lstDefaultRoutings = [...this.leftbind];
          this.instancememberResult += "<p>Delete CFG_GCA_DEFAULTROUTING where FK_DEFAULTROUTING=" + answer + " and FK_CFG_GCA=" + this.FK_CFG_GCA + " ;</p><br>";
          let head = "<p><b>Changes in the routing mappings are: </b></p>";
          let tail = "<p>Rollback;</p>";
          this.TxtQueryWindow = head + this.instancememberResult + tail;
        }
      } else {
        // MessageBox.Show("WebFlow_Internal_Testing cant be removed ");
      }
    }
  }
  get isFormValid() {
    return this.cmbECUGenSelectedItemTemp && this.cmbECUtypeSelectedItemTemp && this.cmbBrandSelectedItemTemp && this.cmbCustomerGroupSelectedItemTemp && this.cmbWorkingmodeSelectedItemTemp;
  }
  Exit() {
    if (this.IsDirty) {
      this.screenAccessPermission.confirm({
        message: 'Do you want to exit from this page?',
        header: 'WARNING',
        icon: 'pi pi-exclamation-triangle',
        accept: () => {
          this.screenAccessPermission.close();
          this.router.navigate(['/Routing']);
        },
        reject: () => {
          this.screenAccessPermission.close();
        }
      });
    } else {
      this.router.navigate(['/Routing']);
    }
  }
