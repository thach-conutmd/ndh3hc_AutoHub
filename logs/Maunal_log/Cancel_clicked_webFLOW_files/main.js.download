    this._ColumnOrder = value;
  }
  /// <summary>
  /// Initializes a new instance of the <see cref="EntityListColumnOrder"/> class.
  /// </summary>
  constructor() {
    //this.ColumnOrder = new Array<number>();
    // Story 613345: HCP1: Implementation of Search logic changes
    this.ColumnOrder = new Array();
    this.ColumnHeaders = [];
  }
  /// <summary>
  /// Adds the column with for specific field with the column name.
  /// </summary>
  /// <param name="fieldIds">The fields identifier.</param>
  /// <param name="columnHeader">The header of the column.</param>
  AddColumn(fieldIds, columnHeader) {
    //let header = { "Key": fieldId, "Value": columnHeader };
    // Story 613345: HCP1: Implementation of Search logic changes
    let header = {
      "Key": fieldIds,
      "Value": columnHeader
    };
    this.ColumnHeaders.push(header);
    this.ColumnOrder.push(fieldIds);
  }
}

