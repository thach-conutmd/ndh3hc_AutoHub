box[_ngcontent-%COMP%] {\n\n    padding-top: 2px;\n}\n\n\n\n\n\n\n.dialog-footer[_ngcontent-%COMP%] {\n\n    display: flex;\n\n    justify-content: flex-end;\n\n    gap: 10px;\n\n    padding-top: 8px;\n}\n\n\n\n\n\n\n.dialog-btn[_ngcontent-%COMP%] {\n\n    height: 38px;\n\n    padding: 0 16px;\n\n    border-radius: 8px;\n\n    border: none;\n\n    display: flex;\n\n    align-items: center;\n\n    gap: 8px;\n\n    font-size: 12px;\n\n    font-weight: 600;\n\n    cursor: pointer;\n}\n\n\n\n\n.primary-btn[_ngcontent-%COMP%] {\n\n    background: #007BC0;\n\n    color: white;\n}\n\n.primary-btn[_ngcontent-%COMP%]:hover {\n\n    background: #006aa6;\n}\n\n\n\n\n.secondary-btn[_ngcontent-%COMP%] {\n\n    background: white;\n\n    color: #334155;\n\n    border: 1px solid #cfd8e3;\n}\n\n.secondary-btn[_ngcontent-%COMP%]:hover {\n\n    background: #f5f8fc;\n}\n\n\n\n\n\n\n  .modern-save-dialog .p-dialog-header-close {\n\n    width: 32px !important;\n\n    height: 32px !important;\n\n    border-radius: 8px !important;\n}\n\n  .modern-save-dialog .p-dialog-header-close:hover {\n\n    background: #eef5ff !important;\n}\n/*# sourceMappingURL=data:application/json;charset=utf-8;base64, */"]
