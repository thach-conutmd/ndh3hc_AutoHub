    var filesUploaded = pdtContainerField.Value.OperationResult.objectVersions[0].versionsForChildren.map;
    let fileListItems = pdtContainerField.FileList.Items.map(s => {
      return {
        ID: 0,
        Bundle: s.Bundle,
        FileClassID: s.FileClassID,
        FileClassName: s.FileClassName,
        FileExtension: s.FileExtension,
        FileFormat: s.FileFormat,
        Class: s.Class,
        SortOrder: s.SortOrder,
        IsActive: s.IsActive,
        person: s.DocPerson,
        ShouldPickResponsiblePerson: s.ShouldPickResponsiblePerson,
        FileUploadCriteria: s.FileUploadCriteria
      };
    });
    const allowFileType = ["word", "excel", "pdf", "unknown"];
    fileListItems = fileListItems.filter(s => s.FileFormat && allowFileType.some(fileType => s.FileFormat.includes(fileType)));
    this.setFileName();
    const uploadList = [];
    const allowFileFormat = ["pdf", "doc", "docx", "xls", "xlsx", "xlsm", "ppt", "pptx"];
    for (const [key, value] of Object.entries(filesUploaded)) {
      if (allowFileFormat.some(fileFormat => key.toLowerCase().includes(`.${fileFormat}`))) {
        uploadList.push(value);
      }
    }
    this.UploadedFiles = uploadList;
    this.groupFileListItem(fileListItems);
    this.isShowPreselectionFiles = !isModifyFileSelect;
    this.isShowPDFExport = true;
  }
