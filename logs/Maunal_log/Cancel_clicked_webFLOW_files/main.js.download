    /// </summary>
    this.IsStarted = false;
    /// <summary>
    /// Indicates whether the service is executing run
    /// </summary>
    this.IsRunning = false;
    /// <summary>
    /// Indicates whether the service is shut down
    /// </summary>
    this.IsShutDown = false;
    /// <summary>
    /// This is the amount of runs performed completely since start of service
    /// </summary>
    this.RunCount = 0;
