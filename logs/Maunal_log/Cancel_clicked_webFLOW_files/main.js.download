/**
 * Entity base class
 * typeparam T Type of the transport class
 */
class Entity {
  /** Initializes a new instance of the Entity class */
  constructor(ctorTO) {
    this._data = new ctorTO();
    this._data.EntityId = null;
  }
  // #region IEntity Members
  /** The entity identifier. */
  get EntityId() {
    return this.data.EntityId;
  }
  /** Gets a value indicating whether this instance is meta entity. */
  get IsMetaEntity() {
    if (this.data.EntityId === undefined || this.data.EntityId === null) {
