    if (this.dialog) {
      let elements = document.getElementsByClassName('ui-table-scrollable-body-table');
      let heightResize = '';
      for (let i = 0; i < elements.length; i++) {
        if (this.dialog.contentViewChild && this.dialog.contentViewChild.nativeElement.style.height) {
          heightResize = this.dialog.contentViewChild.nativeElement.style.height;
          if (heightResize.indexOf('calc') != -1) {
            elements[i]['style']['height'] = String(heightResize).replace('px', 'px - 110px');
          } else {
            elements[i]['style']['height'] = parseInt(heightResize) - 110 + 'px';
          }
        } else {
          elements[i]['style']['height'] = '200px'; //this.dialog._minHeight + "px";
        }
      }
    }
  }
