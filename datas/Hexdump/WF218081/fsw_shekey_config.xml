    </FSW_SHE_BLOCK>
    
    <FSW_SHE_BLOCK>
        <SHE_BLOCK_SHORT_NAME>DYNAMIC_BASIC_SHE_DFLASH_KEY_INST_3</SHE_BLOCK_SHORT_NAME>    <!-- SHE key for SW encryption/decryption key (SHE KEY_4) -->
        <SHE_TYPE>PBDP</SHE_TYPE>
        <SHE_ID>0x07</SHE_ID>
        <SHE_FLAGS>0x00</SHE_FLAGS>
        <SHE_MEK>GenKey_MDG1_HONDA_62XS_SheMasterKey_V01</SHE_MEK>
        <SHE_NEW_KEY>GenEncrSW_MDG1_HONDA_V02</SHE_NEW_KEY>                                 <!-- lae1hc: PBDP SHE key SLOT NAME -->
        <SHE_NEW_KEY_CONTEXT>MG1CS022_CS_woOTA_Enc_Dev_V02</SHE_NEW_KEY_CONTEXT>            <!-- PBDP SHE key CONTEXT -->
    </FSW_SHE_BLOCK>
    
    <FSW_SHE_BLOCK>
        <SHE_BLOCK_SHORT_NAME>DYNAMIC_BASIC_SHE_DFLASH_KEY_INST_7</SHE_BLOCK_SHORT_NAME>    <!-- SHE key for Customer Security Type X( SHE KEY_8) -->
        <SHE_TYPE>SDoACD</SHE_TYPE>
        <SHE_ID>0x0B</SHE_ID>
        <SHE_FLAGS>0x00</SHE_FLAGS>
        <SHE_MEK>GenKey_MDG1_HONDA_62XS_SheMasterKey_V01</SHE_MEK>
        <SHE_NEW_KEY>GenKey_MDG1_HONDA_62XS_V01</SHE_NEW_KEY>                          <!-- lae1hc: SDoACD SHE key SLOT NAME -->
    </FSW_SHE_BLOCK>
</FSW_SHE_BLOCKS>

