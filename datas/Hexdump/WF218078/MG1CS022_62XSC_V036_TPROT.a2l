/begin MEASUREMENT

    abmf_msg
    "injection cut off pattern at fixed position"
    UBYTE
    dez
    1
    100
    0.00
    255.0

    
    FORMAT "%5.1"
    
    ECU_ADDRESS 0x7000366A

/end MEASUREMENT

/begin MEASUREMENT

    abmhdev_msg
    "Cut off pattern high-pressure injection-valve"
    UBYTE
    OneToOne
    1
    100
    0.00
    255.0

    
    FORMAT "%5.1"
    
    ECU_ADDRESS 0x70003669

/end MEASUREMENT

/begin MEASUREMENT

    abmm
    "Injection Cutoff pattern for Torque Reduction"
    UBYTE
    dez
    1
    100
    0.00
    255.0

    
    FORMAT "%5.1"
    
    ECU_ADDRESS 0x70003271

/end MEASUREMENT

/begin MEASUREMENT

    abmznd_msg
    "cut off pattern on ignition circuit error"
    UBYTE
    dez
    1
    100
    0.00
    255.0

    
    FORMAT "%5.1"
    
    ECU_ADDRESS 0x6000EF02

/end MEASUREMENT

/begin MEASUREMENT

    abscissa
    "Index array, that holds abscissa values for linear regression procedure"
    UBYTE
    dez
    1
    100
    0.00
    255.0

    
    FORMAT "%5.1"
    ARRAY_SIZE 6
    ECU_ADDRESS 0x6000B052

/end MEASUREMENT

/begin MEASUREMENT

    ACCI_aReq
    "acceleration request from ACC"
    SWORD
    Acc
    1
    100
    -32.76800
    32.76700

    
    FORMAT "%8.5"
    
    ECU_ADDRESS 0x60000626

/end MEASUREMENT

/begin MEASUREMENT

    ACCI_bACCPrs
    "Adaptive Cruise Control present status"
    UBYTE
    B_TRUE
    1
